local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local Workspace = game:GetService("Workspace")
local LocalPlayer = Players.LocalPlayer -- Must run as a LocalScript

local cfg = _G.Settings
local IgnoredCharacters = {}

local function updateCharacterCache(player, char)
    if not char then return end
    local ignore = (player == LocalPlayer and cfg.Players["Ignore Me"])
        or (player ~= LocalPlayer and cfg.Players["Ignore Others"])
    IgnoredCharacters[char] = ignore or nil
end

local function hookPlayer(player)
    player.CharacterAdded:Connect(function(char)
        updateCharacterCache(player, char)
    end)
    player.CharacterRemoving:Connect(function(char)
        IgnoredCharacters[char] = nil
    end)
end

for _, p in ipairs(Players:GetPlayers()) do
    hookPlayer(p)
    updateCharacterCache(p, p.Character)
end
Players.PlayerAdded:Connect(hookPlayer)

local function isIgnored(inst)
    if inst:IsDescendantOf(Players) then return true end

    local node = inst
    while node do
        if IgnoredCharacters[node] then
            return true
        end
        node = node.Parent
    end
    return false
end

