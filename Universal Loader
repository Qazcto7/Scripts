    end
end

local function applyAfkMode(reasonText)
    local shouldAfk = state.manualAfk or state.focusAfk
    state.afkRenderDisabled = shouldAfk
    state.afkRevision = (state.afkRevision or 0) + 1
    local myRev = state.afkRevision

    syncAfkAudio(shouldAfk)
    syncAfkDarkOverlay(shouldAfk)
    refreshControlPanel()

    if shouldAfk then
        -- Let 2 full Render passes complete & flush DXVK SwapChain before pausing 3D rendering and capping FPS to 5
        if hasRealSpawn and spawnTask then
            state.afkPaintPending = true
            spawnTask(function()
                waitRenderFrame()
                if isActive() and state.afkRevision == myRev and state.afkRenderDisabled then
                    updateOverlayStatusLabel()
                    refreshControlPanel()
                end
                waitRenderFrame()
                waitRenderFrame()
                if isActive() and state.afkRevision == myRev then
                    state.afkPaintPending = false
                    if state.afkRenderDisabled then
                        applyRenderAfkState(true)
                    end
                end
            end)
        else
            state.afkPaintPending = false
            applyRenderAfkState(true)
        end
    else
        state.afkPaintPending = false
        applyRenderAfkState(false)
    end

    if reasonText then
        notify("Universal Loader", reasonText)
    end
end

