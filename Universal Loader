local function safeEnv()
    if type(getgenv) == "function" then
        local ok, genv = pcall(getgenv)
        if ok and type(genv) == "table" then
            return genv
        end
    end
    return _G
end

local env = safeEnv()

local waitTask = (type(task) == "table" and type(task.wait) == "function" and task.wait) or wait or function() end
local spawnTask = (type(task) == "table" and type(task.spawn) == "function" and task.spawn)
    or (type(spawn) == "function" and spawn)
    or (type(coroutine) == "table" and type(coroutine.create) == "function" and function(fn)
        local co = coroutine.create(fn)
        local ok, err = coroutine.resume(co)
        if not ok and warn then
            warn("[Universal Loader] Task error:", err)
        end
        return co
    end)
    or nil
local cancelTask = (type(task) == "table" and type(task.cancel) == "function" and task.cancel) or nil
local compileLua = loadstring or load

