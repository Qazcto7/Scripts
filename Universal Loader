local function fetchUrl(url, preferRequestFirst, maxAttempts)
    local reqFn = getRequestFn()
    local attempts = math.max(1, tonumber(maxAttempts) or cfg.RetryHttpAttempts)
    local function tryHttpGet()
        if game and type(game.HttpGet) == "function" then
            local ok, body = pcall(function()
                return game:HttpGet(url, true)
            end)
            if ok and type(body) == "string" and body ~= "" then
                return body, nil, 200
            end
        end
        return nil, nil, nil
    end

    local function tryRequest()
        if reqFn then
            local ok, res = pcall(reqFn, {
                Url = url,
                Method = "GET",
            })
            if ok and type(res) == "table" then
                local status = tonumber(res.StatusCode)
                if status == 429 or status == 403 then
                    return nil, "HTTP " .. tostring(status), status
                end
                if type(res.Body) == "string" and res.Body ~= "" then
                    if not status or (status >= 200 and status < 300) then
                        return res.Body, nil, status or 200
                    end
                    return nil, "HTTP " .. tostring(status), status
                end
            end
        end
        return nil, nil, nil
    end

    for attempt = 1, attempts do
        if not isActive() then
            return nil, "inactive", nil
        end

        local body, reqErr, status
        if preferRequestFirst and reqFn then
            body, reqErr, status = tryRequest()
            if body then
                return body, nil, status
            end
            if status == 429 or status == 403 then
                return nil, reqErr, status
            end
            body, reqErr, status = tryHttpGet()
            if body then
                return body, nil, status
            end
        else
            body, reqErr, status = tryHttpGet()
            if body then
                return body, nil, status
            end
            body, reqErr, status = tryRequest()
            if body then
                return body, nil, status
            end
            if status == 429 or status == 403 then
                return nil, reqErr, status
            end
        end

        if attempt < attempts then
            waitTask(0.5)
        end
    end
    return nil, "HTTP fetch failed", nil
end

local function executeSource(source, label)
    if type(compileLua) ~= "function" then
        if warn then
            warn("[Universal Loader] No loadstring/load available for " .. label)
        end
        return false
    end
    local fn, compileErr = compileLua(source)
    if not fn then
        if warn then
            warn("[Universal Loader] Compile error in " .. label .. ":", compileErr)
        end
        return false
    end
    local ok, runErr = pcall(fn)
    if not ok then
        if warn then
            warn("[Universal Loader] Runtime error in " .. label .. ":", runErr)
        end
        return false
    end
    return true
end

local function runUrlOrCode(entry, label, useCache)
    if type(entry) ~= "string" or entry == "" then
        return false
    end
    local trimmed = entry:match("^%s*(.-)%s*$") or ""
    if trimmed:match("^https?://") then
        local cached = useCache and state.sourceCache[trimmed] or nil
        if type(cached) == "string" and cached ~= "" then
            return executeSource(cached, label)
        end
        local src, fetchErr = fetchUrl(trimmed)
        if not src then
            if warn then
                warn("[Universal Loader] Failed to fetch " .. label .. ":", fetchErr)
            end
            return false
        end
        state.sourceCache[trimmed] = src
        return executeSource(src, label)
    end
    return executeSource(entry, label)
end

local function quoteString(str)
    return '"' .. str
        :gsub("\\", "\\\\")
        :gsub('"', '\\"')
        :gsub("\r", "\\r")
        :gsub("\n", "\\n")
        :gsub("\t", "\\t")
        :gsub("%z", "\\000") .. '"'
end

local function serializeValue(val, visited, depth)
    depth = depth or 0
    if depth > 8 then
        return nil
    end

    local t = type(val)
    if t == "boolean" then
        return tostring(val)
    elseif t == "number" then
        if val ~= val or val == math.huge or val == -math.huge then
            return nil
        end
        return tostring(val)
    elseif t == "string" then
        return quoteString(val)
    elseif t == "userdata" then
        -- Serialize EnumItem cleanly (e.g. Enum.KeyCode.F8 -> "F8")
        local okName, name = pcall(function()
            return val.Name
        end)
        if okName and type(name) == "string" then
            return quoteString(name)
        end
        return nil
    elseif t == "table" then
        visited = visited or {}
        if visited[val] then
            return nil
        end
        visited[val] = true

        local parts = {}
        local usedArrayIdx = {}
        for i = 1, #val do
            local serialized = serializeValue(val[i], visited, depth + 1)
            if serialized ~= nil then
                usedArrayIdx[i] = true
                table.insert(parts, serialized)
            end
        end

        for k, v in pairs(val) do
            local isUsedArray = type(k) == "number" and usedArrayIdx[k]
            if not isUsedArray and (type(k) == "string" or type(k) == "number") then
                local serializedVal = serializeValue(v, visited, depth + 1)
                if serializedVal ~= nil then
                    local keyExpr = type(k) == "string" and ("[" .. quoteString(k) .. "]") or ("[" .. tostring(k) .. "]")
                    table.insert(parts, keyExpr .. "=" .. serializedVal)
                end
            end
        end

        visited[val] = nil
        return "{" .. table.concat(parts, ",") .. "}"
    end

    return nil
end

local function buildReplayCode()
    local targetUrl = (type(cfg.QueueUrl) == "string" and cfg.QueueUrl ~= "" and cfg.QueueUrl) or cfg.LoaderUrl
    if type(targetUrl) ~= "string" or targetUrl == "" then
        return nil
    end

    local persistedLoaderCfg = deepCopy(userLoaderCfg)
    if not cfg.QueueExtraScripts then
        persistedLoaderCfg.ExtraScripts = {}
        persistedLoaderCfg.ExtraCode = nil
    end
    persistedLoaderCfg.Preset = cfg.Preset
    persistedLoaderCfg.BaseUrl = cfg.BaseUrl
    persistedLoaderCfg.LoaderUrl = cfg.LoaderUrl
    if cfg.QueueUrl ~= nil then
        persistedLoaderCfg.QueueUrl = cfg.QueueUrl
    end

    -- Preserve explicit sub-module overrides across teleports if present
    local optUser = readUnownedSlot("Settings", "__UniversalLoaderOwnedOpt")
    local afkUser = readUnownedSlot("AntiAFKSettings", "__UniversalLoaderOwnedAFK")
    local recUser = readUnownedSlot("AutoReconnectSettings", "__UniversalLoaderOwnedReconnect")

    local chunks = {
        "local g=(type(getgenv)=='function' and getgenv()) or _G;",
    }

    local loaderSerialized = serializeValue(persistedLoaderCfg)
    if loaderSerialized then
        table.insert(chunks, "local lc=" .. loaderSerialized .. ";_G.UniversalLoaderSettings=lc;g.UniversalLoaderSettings=lc;")
    end
    if optUser then
        local s = serializeValue(optUser)
        if s then
            table.insert(chunks, "local oc=" .. s .. ";_G.Settings=oc;g.Settings=oc;")
        end
    end
    if afkUser then
        local s = serializeValue(afkUser)
        if s then
            table.insert(chunks, "local ac=" .. s .. ";_G.AntiAFKSettings=ac;g.AntiAFKSettings=ac;")
        end
    end
    if recUser then
        local s = serializeValue(recUser)
        if s then
            table.insert(chunks, "local rc=" .. s .. ";_G.AutoReconnectSettings=rc;g.AutoReconnectSettings=rc;")
        end
    end

    table.insert(chunks, "loadstring(game:HttpGet(" .. quoteString(targetUrl) .. ",true))()")
    return table.concat(chunks, "")
end

