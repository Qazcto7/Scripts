local function syncAfkAudio(shouldMute)
    if not cfg.MuteSoundsOnAFK then
        return
    end
    local gs = getUserGameSettings()
    if not gs then
        return
    end
    if shouldMute then
        if state.savedMasterVolume == nil then
            local okVol, curVol = pcall(function()
                return gs.MasterVolume
            end)
            if okVol and type(curVol) == "number" then
                state.savedMasterVolume = curVol
            end
        end
        pcall(function()
            gs.MasterVolume = 0
        end)
    elseif state.savedMasterVolume ~= nil then
        local prevVol = state.savedMasterVolume
        state.savedMasterVolume = nil
        if not cfg.MuteAllSounds then
            pcall(function()
                gs.MasterVolume = prevVol
            end)
        end
    end
end

