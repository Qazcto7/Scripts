if (state.afkRenderDisabled and restoredCap == 15) or restoredCap <= 0 then
    restoredCap = 999
end

-- Live AFK toggle hotkey & overlay helpers (toggles 3D rendering and FPS cap safely)
local function resolveKeyCode(keySpec)
    if not Enum or not Enum.KeyCode or keySpec == nil or keySpec == false then
        return nil
    end
    if type(keySpec) == "userdata" then
        return keySpec
    end
    if type(keySpec) == "string" and keySpec ~= "" then
        local ok, key = pcall(function()
            return Enum.KeyCode[keySpec]
        end)
        if ok and key then
            return key
        end
    end
    return nil
end

local toggleKey = resolveKeyCode(cfg.AFKToggleKey)
local OVERLAY_NAME = "__UniversalLoaderAFKOverlay"

local function destroyExistingOverlay(parent)
    if not parent or type(parent.FindFirstChild) ~= "function" then
        return
    end
    pcall(function()
        local old = parent:FindFirstChild(OVERLAY_NAME)
        if old then
            old:Destroy()
        end
    end)
end

local function getHiddenUiContainer()
    local gethuiFn = pickFirstFunction(gethui, env.gethui)
    if not gethuiFn then
        return nil
    end
    local okHui, resHui = pcall(gethuiFn)
    if okHui and resHui then
        return resHui
    end
    return nil
end

local function getOverlayContainers(allowHui)
    local coreGui = safeGetService("CoreGui")
    local hiddenUi = allowHui and getHiddenUiContainer() or nil
    local playerGui = nil
    if LocalPlayer then
        local okPg, pg = pcall(function()
            return LocalPlayer:FindFirstChildOfClass("PlayerGui")
        end)
        if okPg and pg then
            playerGui = pg
        end
    end
    return coreGui, hiddenUi, playerGui
end

local function clearAllOverlays(coreGui, hiddenUi, playerGui)
    destroyExistingOverlay(coreGui)
    destroyExistingOverlay(hiddenUi)
    destroyExistingOverlay(playerGui)
end

local function attachOverlayParent(gui, candidate, displayOrder)
    if not candidate then
        return false
    end
    local ok = pcall(function()
        gui.DisplayOrder = displayOrder
        gui.Parent = candidate
    end)
    return ok and gui.Parent == candidate
end

local function createDarkOverlay(keyObj)
    local okInst, instLib = pcall(function()
        return Instance
    end)
    if not okInst or not instLib or type(instLib.new) ~= "function" then
        return nil
    end

    local allowHui = (env.__UniversalLoaderUsedHui == true)
    local coreGui, hiddenUi, playerGui = getOverlayContainers(allowHui)
    clearAllOverlays(coreGui, hiddenUi, playerGui)

    local gui = nil
    local okCreate = pcall(function()
        gui = instLib.new("ScreenGui")
        gui.Name = OVERLAY_NAME
        gui.IgnoreGuiInset = true
        gui.ResetOnSpawn = false
        gui.Enabled = false

        local backdrop = instLib.new("Frame")
        backdrop.Name = "Backdrop"
        if UDim2 and type(UDim2.new) == "function" then
            backdrop.Size = UDim2.new(1, 0, 1, 0)
            backdrop.Position = UDim2.new(0, 0, 0, 0)
        end
        backdrop.BorderSizePixel = 0
        backdrop.BackgroundTransparency = 0
        backdrop.Active = false
        pcall(function()
            if Color3 and type(Color3.fromRGB) == "function" then
                backdrop.BackgroundColor3 = Color3.fromRGB(10, 10, 14)
            end
        end)
        backdrop.Parent = gui

        local label = instLib.new("TextLabel")
        label.Name = "Status"
        if UDim2 and type(UDim2.new) == "function" then
            label.Size = UDim2.new(1, -40, 0, 56)
            label.Position = UDim2.new(0, 20, 0.5, -28)
        end
        label.BackgroundTransparency = 1
        label.TextWrapped = true
        label.TextSize = 16

        local keyLabel = nil
        if keyObj then
            local okKeyName, kName = pcall(function()
                return keyObj.Name
            end)
            if okKeyName and type(kName) == "string" and kName ~= "" then
                keyLabel = kName
            end
        end
        label.Text = keyLabel
            and string.format("AFK Mode Active (15 FPS)\nPress %s to restore 3D view", keyLabel)
            or "AFK Mode Active (3D Rendering Paused)"

        pcall(function()
            if Color3 and type(Color3.fromRGB) == "function" then
                label.TextColor3 = Color3.fromRGB(145, 150, 165)
            end
            if Enum and Enum.Font and Enum.Font.SourceSans then
                label.Font = Enum.Font.SourceSans
            end
        end)
        label.Parent = backdrop
    end)

    if not okCreate or not gui then
        return nil
    end

    local attached = attachOverlayParent(gui, coreGui, -10)
        or attachOverlayParent(gui, playerGui, 2147483647)

    if not attached then
        hiddenUi = hiddenUi or getHiddenUiContainer()
        if hiddenUi then
            destroyExistingOverlay(hiddenUi)
            attached = attachOverlayParent(gui, hiddenUi, -10)
            if attached then
                pcall(function()
                    env.__UniversalLoaderUsedHui = true
                end)
            end
        end
    end

    if not attached then
        pcall(function()
            gui:Destroy()
        end)
        return nil
    end
    return gui
end

local function syncAfkDarkOverlay(enabled)
    if not cfg.AFKDarkScreen or not enabled then
        if state.afkOverlay then
            pcall(function()
                state.afkOverlay.Enabled = false
            end)
        elseif cfg.AFKDarkScreen then
            local allowHui = (env.__UniversalLoaderUsedHui == true)
            local coreGui, hiddenUi, playerGui = getOverlayContainers(allowHui)
            clearAllOverlays(coreGui, hiddenUi, playerGui)
        end
        return
    end

    if not state.afkOverlay or not state.afkOverlay.Parent then
        state.afkOverlay = createDarkOverlay(toggleKey)
    end
    if state.afkOverlay then
        pcall(function()
            state.afkOverlay.Enabled = true
        end)
    end
end

-- Arm teleport replay and live F8 AFK hotkey immediately before staged module execution
local queueArmed = armTeleportQueueOnce()
syncAfkDarkOverlay(state.afkRenderDisabled)

if toggleKey and UserInputService and UserInputService.InputBegan then
    local setFpsCapFn = type(setfpscap) == "function" and setfpscap or nil
    trackConnection(UserInputService.InputBegan, function(input, gameProcessed)
        if not isActive() or gameProcessed or not input then
            return
        end
        if input.KeyCode == toggleKey then
            state.afkRenderDisabled = not state.afkRenderDisabled
            state.afkToggledManually = true
            if RunService and type(RunService.Set3dRenderingEnabled) == "function" then
                pcall(RunService.Set3dRenderingEnabled, RunService, not state.afkRenderDisabled)
            end
            if setFpsCapFn then
                pcall(setFpsCapFn, state.afkRenderDisabled and 15 or restoredCap)
            end
            syncAfkDarkOverlay(state.afkRenderDisabled)
            notify(
                "Universal Loader",
                state.afkRenderDisabled and "AFK mode ON (3D rendering paused)" or "AFK mode OFF (3D rendering restored)"
            )
        end
    end)
end

local function waitStage(seconds)
    if not isActive() then
        return false
    end
    if cfg.StagedExecution and seconds > 0 then
        waitTask(seconds)
    end
    return isActive()
end

local function runModulesPipeline()
    local loadedModules = {}

    -- 1. Anti-AFK (delayed slightly after script injection)
    if cfg.LoadAntiAFK and waitStage(cfg.AntiAFKDelay) then
        local afkOverride = readUnownedSlot("AntiAFKSettings", "__UniversalLoaderOwnedAFK")
        local finalAfk = mergeTables(afkOverride or {}, cfg.AntiAFKSettings)
        if next(finalAfk) ~= nil then
            writeConfigSlot("AntiAFKSettings", finalAfk)
        end
        if runUrlOrCode(cfg.BaseUrl .. "Anti-AFK", "Anti-AFK") then
            table.insert(loadedModules, "Anti-AFK")
        end
        env.__UniversalLoaderOwnedAFK = env.AntiAFKSettings or (_G and _G.AntiAFKSettings)
    end

    if not isActive() then
        return
    end

    -- 2. Optimizer (runs after Anti-AFK settles, respecting any live AFK toggle made in the meantime)
    if cfg.LoadOptimizer and waitStage(cfg.OptimizerDelay) then
        local userOpt = readUnownedSlot("Settings", "__UniversalLoaderOwnedOpt")
        local finalOpt = mergeTables(presetBase, cfg.OptimizerSettings)
        if userOpt then
            finalOpt = mergeTables(finalOpt, userOpt)
        end
        finalOpt.Other = finalOpt.Other or {}

        local explicitCap = tonumber(finalOpt.Other["FPS Cap"])
        if explicitCap and explicitCap > 0 and not (state.afkRenderDisabled and explicitCap == 15) then
            restoredCap = explicitCap
        end

        if state.afkToggledManually then
            finalOpt.Other["Disable 3D Rendering"] = state.afkRenderDisabled
            if state.afkRenderDisabled then
                finalOpt.Other["FPS Cap"] = 15
            else
                finalOpt.Other["FPS Cap"] = (restoredCap ~= 999) and restoredCap or false
            end
        elseif finalOpt.Other["Disable 3D Rendering"] ~= nil then
            state.afkRenderDisabled = finalOpt.Other["Disable 3D Rendering"] == true
        end

        writeConfigSlot("Settings", finalOpt)
        if runUrlOrCode(cfg.BaseUrl .. "Optimizer", "Optimizer") then
            table.insert(loadedModules, "Optimizer")
        end
        env.__UniversalLoaderOwnedOpt = env.Settings or (_G and _G.Settings)
    end

    if not isActive() then
        return
    end

    -- 3. Auto-Reconnect (after Optimizer)
    if cfg.LoadAutoReconnect and waitStage(cfg.AutoReconnectDelay) then
        local userRec = readUnownedSlot("AutoReconnectSettings", "__UniversalLoaderOwnedReconnect")
        local baseRec = {
            QueueOnTeleport = cfg.AutoQueueOnTeleport,
            QueueScript = replayCode,
        }
        local finalRec = mergeTables(baseRec, cfg.AutoReconnectSettings)
        if userRec then
            finalRec = mergeTables(finalRec, userRec)
        end

        writeConfigSlot("AutoReconnectSettings", finalRec)
        if runUrlOrCode(cfg.BaseUrl .. "Auto-Reconnect", "Auto-Reconnect") then
            table.insert(loadedModules, "Auto-Reconnect")
        end
        env.__UniversalLoaderOwnedReconnect = env.AutoReconnectSettings or (_G and _G.AutoReconnectSettings)
    end

    -- 4. Optional user custom scripts / inline code
    local hasExtras = (#cfg.ExtraScripts > 0) or (type(cfg.ExtraCode) == "string" and cfg.ExtraCode ~= "")
    if hasExtras and waitStage(cfg.ExtraScriptsDelay) then
        for idx, scriptEntry in ipairs(cfg.ExtraScripts) do
            if not isActive() then
                break
            end
            if runUrlOrCode(scriptEntry, "ExtraScript#" .. tostring(idx)) then
                table.insert(loadedModules, "Extra#" .. tostring(idx))
            end
        end

        if type(cfg.ExtraCode) == "string" and cfg.ExtraCode ~= "" and isActive() then
            if executeSource(cfg.ExtraCode, "ExtraCode") then
                table.insert(loadedModules, "ExtraCode")
            end
        end
    end

    if isActive() then
        state.stageThread = nil
        notify(
            "Universal Loader",
            string.format("Loaded (%s)%s", tostring(cfg.Preset), queueArmed and " + Queue armed" or "")
        )
        print(string.format(
            "[Universal Loader] Loaded! Preset=%s | Queue=%s | Modules=%s",
            tostring(cfg.Preset),
            queueArmed and "Armed" or "Skipped",
            #loadedModules > 0 and table.concat(loadedModules, ", ") or "None"
        ))
    end
end

if cfg.StagedExecution and spawnTask then
    state.stageThread = spawnTask(runModulesPipeline)
else
    runModulesPipeline()
end
