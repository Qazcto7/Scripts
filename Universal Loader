local function formatOverlayText(elapsedSec)
    local total = math.max(0, math.floor(elapsedSec or 0))
    local hrs = math.floor(total / 3600)
    local mins = math.floor((total % 3600) / 60)
    local secs = total % 60
    local timerPart = cfg.AFKOverlayTimer and string.format("  |  %02d:%02d:%02d", hrs, mins, secs) or ""

    if state.afkKeyLabel then
        return string.format("AFK Mode Active (%d FPS)%s\nPress %s to restore 3D view", cfg.AFKFPSCap, timerPart, state.afkKeyLabel)
    end
    if cfg.AFKOverlayTimer then
        return string.format("AFK Mode Active (%d FPS)%s", cfg.AFKFPSCap, timerPart)
    end
    return "AFK Mode Active (3D Rendering Paused)"
end

local function updateOverlayStatusLabel()
    local lbl = state.afkStatusLabel
    if not lbl then
        return
    end
    local elapsed = state.afkStartedAt and (clockNow() - state.afkStartedAt) or 0
    pcall(function()
        lbl.Text = formatOverlayText(elapsed)
        -- Reading AbsoluteSize forces Roblox's 2D UI layout pass to commit text changes immediately
        local _ = lbl.AbsoluteSize
    end)
end

local function waitRenderFrame()
    local rs = RunService and RunService.RenderStepped
    if rs and type(rs.Wait) == "function" then
        local ok = pcall(rs.Wait, rs)
        if ok then
            return
        end
    end
    waitTask()
end

local function stopOverlayTimer()
    state.timerRevision = (state.timerRevision or 0) + 1
    if state.overlayThread then
        local ot = state.overlayThread
        state.overlayThread = nil
        if cancelTask then
            pcall(cancelTask, ot)
        end
    end
    state.afkStartedAt = nil
end

local function refreshControlPanel()
    if type(state.panelRefreshFn) == "function" then
        pcall(state.panelRefreshFn)
    end
end

local function startOverlayTimer()
    state.afkStartedAt = state.afkStartedAt or clockNow()
    updateOverlayStatusLabel()
    if not cfg.AFKOverlayTimer or not hasRealSpawn or state.overlayThread then
        return
    end
    state.timerRevision = (state.timerRevision or 0) + 1
    local myTimerRev = state.timerRevision
    state.overlayThread = spawnTask(function()
        local stuckTicks = 0
        while isActive() and state.timerRevision == myTimerRev and state.afkRenderDisabled and state.afkOverlay do
            local beforeTick = clockNow()
            local curElapsed = math.max(0, beforeTick - (state.afkStartedAt or beforeTick))
            local nextWholeSec = math.floor(curElapsed) + 1
            local sleepSec = math.max(0.1, nextWholeSec - curElapsed + 0.02)
            waitTask(sleepSec)
            if not isActive() or state.timerRevision ~= myTimerRev or not state.afkRenderDisabled or not state.afkOverlay then
                break
            end
            local afterTick = clockNow()
            if afterTick <= beforeTick then
                stuckTicks = stuckTicks + 1
                if stuckTicks >= 5 then
                    break
                end
            else
                stuckTicks = 0
            end

            -- Wake 3D rendering BEFORE modifying text, then wait across RenderStepped boundaries so
            -- Step 5 Render + double/triple-buffered DXVK SwapChain::Present actually flips the new frame.
            if not state.afkPaintPending and RunService and type(RunService.Set3dRenderingEnabled) == "function" and state.afkRenderDisabled then
                local pulseRev = state.afkRevision
                pcall(RunService.Set3dRenderingEnabled, RunService, true)
                waitRenderFrame()
                if not isActive() or state.timerRevision ~= myTimerRev or not state.afkRenderDisabled or not state.afkOverlay or state.afkRevision ~= pulseRev then
                    break
                end
                updateOverlayStatusLabel()
                refreshControlPanel()
                waitRenderFrame()
                if not isActive() or state.timerRevision ~= myTimerRev or not state.afkRenderDisabled or not state.afkOverlay or state.afkRevision ~= pulseRev then
                    break
                end
                waitRenderFrame()
                if isActive() and state.timerRevision == myTimerRev and state.afkRenderDisabled and state.afkOverlay and state.afkRevision == pulseRev then
                    pcall(RunService.Set3dRenderingEnabled, RunService, false)
                end
            else
                updateOverlayStatusLabel()
                refreshControlPanel()
            end
        end
        if state.timerRevision == myTimerRev then
            state.overlayThread = nil
        end
    end)
end

