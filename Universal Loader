function state.cleanup()
    state.active = false
    state.afkRevision = (state.afkRevision or 0) + 1
    state.timerRevision = (state.timerRevision or 0) + 1
    state.afkPaintPending = false
    state.panelVisible = false
    state.panelRefreshFn = nil
    state.teleportBusy = false
    state.teleportBusyUntil = 0
    state.presetBusy = false
    state.presetBtn = nil
    state.afkBtn = nil
    state.rejoinBtn = nil
    state.hopBtn = nil
    state.lowHopBtn = nil
    env.__UniversalLoaderTeleporting = nil
    if env.__UniversalLoaderHoppingUntil ~= nil then
        env.__UniversalLoaderHoppingUntil = nil
    end
    if state.overlayThread then
        local ot = state.overlayThread
        state.overlayThread = nil
        if cancelTask then
            pcall(cancelTask, ot)
        end
    end
    if state.stageThread then
        local st = state.stageThread
        state.stageThread = nil
        if cancelTask then
            pcall(cancelTask, st)
        end
    end
    if state.savedMasterVolume ~= nil and type(UserSettings) == "function" then
        local prevVol = state.savedMasterVolume
        state.savedMasterVolume = nil
        pcall(function()
            local gs = UserSettings():GetService("UserGameSettings")
            if gs then
                gs.MasterVolume = prevVol
            end
        end)
    end
    state.afkStatusLabel = nil
    state.afkStartedAt = nil
    if state.afkOverlay then
        local overlay = state.afkOverlay
        state.afkOverlay = nil
        pcall(function()
            overlay.Enabled = false
            overlay:Destroy()
        end)
    end
    if state.panelGui then
        local panel = state.panelGui
        state.panelGui = nil
        pcall(function()
            panel.Enabled = false
            panel:Destroy()
        end)
    end
    if state.api then
        if env.UniversalLoader == state.api then
            env.UniversalLoader = nil
        end
        if _G and _G.UniversalLoader == state.api then
            _G.UniversalLoader = nil
        end
    end
    for i = #state.connections, 1, -1 do
        local conn = state.connections[i]
        state.connections[i] = nil
        if conn then
            pcall(function()
                conn:Disconnect()
            end)
        end
    end
end

