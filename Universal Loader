    if type(b) == "function" then return b end
    if type(c) == "function" then return c end
    if type(d) == "function" then return d end
    if type(e) == "function" then return e end
    if type(f) == "function" then return f end
    if type(g) == "function" then return g end
    if type(h) == "function" then return h end
    return nil
end

