    pcall(env.__UniversalLoaderState.cleanup)
end

local state = {
    runId = runId,
    active = true,
    afkRenderDisabled = false,
    afkToggledManually = false,
    afkOverlay = nil,
    stageThread = nil,
    connections = {},
}

function state.cleanup()
    state.active = false
    if state.stageThread then
        local st = state.stageThread
        state.stageThread = nil
        if cancelTask then
            pcall(cancelTask, st)
        end
    end
    if state.afkOverlay then
        local overlay = state.afkOverlay
        state.afkOverlay = nil
        pcall(function()
            overlay.Enabled = false
            overlay:Destroy()
        end)
    end
    for i = #state.connections, 1, -1 do
        local conn = state.connections[i]
        state.connections[i] = nil
        if conn then
            pcall(function()
                conn:Disconnect()
            end)
        end
    end
end

env.__UniversalLoaderState = state

local function isActive()
    return state.active and env.__UniversalLoaderRunId == runId
end

local function trackConnection(signal, callback)
    if not signal then
        return nil
    end
    local ok, conn = pcall(function()
        return signal:Connect(callback)
    end)
    if ok and conn then
        table.insert(state.connections, conn)
        return conn
    end
    return nil
end

local function deepCopy(val, visited)
    if type(val) ~= "table" then
        return val
    end
    visited = visited or {}
    if visited[val] then
        return visited[val]
    end
    local out = {}
    visited[val] = out
    for k, v in pairs(val) do
        out[k] = deepCopy(v, visited)
    end
    return out
end

local function mergeTables(base, overrides)
    local result = type(base) == "table" and deepCopy(base) or {}
    if type(overrides) ~= "table" then
        return result
    end
    for k, v in pairs(overrides) do
        if type(v) == "table" and type(result[k]) == "table" then
            result[k] = mergeTables(result[k], v)
        elseif type(v) == "table" then
            result[k] = deepCopy(v)
        else
            result[k] = v
        end
    end
    return result
end

local function readConfigSlot(slotName)
    local gVal = _G and _G[slotName]
    local eVal = env[slotName]
    if type(gVal) == "table" and type(eVal) == "table" and gVal ~= eVal then
        return mergeTables(gVal, eVal)
    elseif type(eVal) == "table" then
        return deepCopy(eVal)
    elseif type(gVal) == "table" then
        return deepCopy(gVal)
    end
    return {}
end

local function readUnownedSlot(slotName, ownedTagName)
    local owned = env[ownedTagName]
    local gVal = _G and _G[slotName]
    local eVal = env[slotName]
    local useG = type(gVal) == "table" and gVal ~= owned
    local useE = type(eVal) == "table" and eVal ~= owned

    if useG and useE and gVal ~= eVal then
        return mergeTables(gVal, eVal)
    elseif useE then
        return deepCopy(eVal)
    elseif useG then
        return deepCopy(gVal)
    end
    return nil
end

local function writeConfigSlot(slotName, tbl)
    if _G then
        _G[slotName] = tbl
    end
    if env ~= _G then
        env[slotName] = tbl
    end
end

