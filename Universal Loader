local function attachOverlayParent(gui, candidate, displayOrder)
    if not candidate then
        return false
    end
    local ok = pcall(function()
        gui.DisplayOrder = displayOrder
        gui.Parent = candidate
    end)
    return ok and gui.Parent == candidate
end

local function attachUniversalGui(gui, guiName, primaryOrder, playerGuiOrder)
    local allowHui = (env.__UniversalLoaderUsedHui == true)
    local coreGui, hiddenUi, playerGui = getOverlayContainers(allowHui)
    clearAllOverlays(coreGui, hiddenUi, playerGui, guiName)

    local attached = attachOverlayParent(gui, coreGui, primaryOrder)
        or attachOverlayParent(gui, playerGui, playerGuiOrder or 2147483647)

    if not attached then
        hiddenUi = hiddenUi or getHiddenUiContainer()
        if hiddenUi then
            destroyNamedGui(hiddenUi, guiName)
            attached = attachOverlayParent(gui, hiddenUi, primaryOrder)
            if attached then
                pcall(function()
                    env.__UniversalLoaderUsedHui = true
                end)
            end
        end
    end
    return attached
end

