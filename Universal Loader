function api.IsAFK()
    return state.afkRenderDisabled == true
end

function api.GetPreset()
    return CANONICAL_PRESETS[presetKey] or tostring(cfg.Preset or "Balanced")
end

function api.SetAFK(first, second)
    if not isActive() then
        return state.afkRenderDisabled == true
    end
    local enabled = unwrapApiArg(first, second) == true
    state.manualAfk = enabled
    state.afkToggledManually = true
    applyAfkMode(
        (state.manualAfk or state.focusAfk)
            and "AFK mode ON (3D rendering paused)"
            or "AFK mode OFF (3D rendering restored)"
    )
    return state.afkRenderDisabled == true
end

function api.ToggleAFK()
    if state.afkRenderDisabled then
        state.focusAfk = false
        return api.SetAFK(false)
    end
    return api.SetAFK(true)
end

function api.SetPreset(first, second)
    if not isActive() then
        return nil
    end
    local requested = unwrapApiArg(first, second)
    local nextKey = string.lower(tostring(requested or "balanced"))
    if not PRESET_OPTIMIZER_OVERRIDES[nextKey] then
        nextKey = "balanced"
    end

    presetKey = nextKey
    presetBase = PRESET_OPTIMIZER_OVERRIDES[presetKey]
    cfg.Preset = CANONICAL_PRESETS[presetKey]
    userLoaderCfg.Preset = cfg.Preset

    local nextReplay = buildReplayCode()
    if nextReplay then
        replayCode = nextReplay
        env.__UniversalLoaderReplayCode = replayCode
    end

    state.manualAfk = (presetKey == "afk")
    state.afkToggledManually = true

    local finalOpt = buildOptimizerSettings(false)
    -- Let applyAfkMode handle 3D rendering pause & FPS cap after painting overlay/panel across frames
    finalOpt.Other["Disable 3D Rendering"] = false
    if state.manualAfk then
        finalOpt.Other["FPS Cap"] = false
    end

    if cfg.LoadOptimizer then
        writeConfigSlot("Settings", finalOpt)
        runUrlOrCode(cfg.BaseUrl .. "Optimizer", "Optimizer", true)
        env.__UniversalLoaderOwnedOpt = env.Settings or (_G and _G.Settings)
    end

    applyAfkMode("Preset: " .. cfg.Preset)

    refreshControlPanel()
    return cfg.Preset
end

function api.CyclePreset()
    local current = api.GetPreset()
    local nextPreset = PRESET_CYCLE[1]
    for i, name in ipairs(PRESET_CYCLE) do
        if name == current then
            nextPreset = PRESET_CYCLE[(i % #PRESET_CYCLE) + 1]
            break
        end
    end
    return api.SetPreset(nextPreset)
end

local function setBtnLabel(btn, text)
    if btn then
        pcall(function()
            btn.Text = text
        end)
    end
end

local function scheduleTeleportUnlock(delaySec, btn, failText)
    state.teleportBusy = false
    env.__UniversalLoaderTeleporting = nil
    if env.__UniversalLoaderHoppingUntil and clockNow() >= (tonumber(env.__UniversalLoaderHoppingUntil) or 0) then
        env.__UniversalLoaderHoppingUntil = nil
    end
    if failText and btn then
        setBtnLabel(btn, failText)
        if hasRealSpawn and spawnTask then
            spawnTask(function()
                waitTask(delaySec or 2)
                if isActive() then
                    refreshControlPanel()
                end
            end)
            return
        end
    end
    refreshControlPanel()
end

local function prepareForTeleport()
    env.__UniversalLoaderTeleporting = true
    if state.afkRenderDisabled or state.focusAfk then
        state.manualAfk = false
        state.focusAfk = false
        state.afkRenderDisabled = false
        if RunService and type(RunService.Set3dRenderingEnabled) == "function" then
            pcall(RunService.Set3dRenderingEnabled, RunService, true)
        end
        syncAfkDarkOverlay(false)
    end
    if type(env.__OptimizerState) == "table" and type(env.__OptimizerState.cleanup) == "function" then
        pcall(env.__OptimizerState.cleanup)
    end
    if type(env.__AntiAFKState) == "table" and type(env.__AntiAFKState.cleanup) == "function" then
        pcall(env.__AntiAFKState.cleanup)
    end
    if type(env.__AutoReconnectState) == "table" and type(env.__AutoReconnectState.cleanup) == "function" then
        pcall(env.__AutoReconnectState.cleanup)
    end
    if hasRealSpawn then
        waitTask(0.1)
    end
end

function api.Rejoin(first, second)
    if not isActive() then
        return false, "inactive"
    end
    if state.teleportBusy and clockNow() < state.teleportBusyUntil then
        return false, "Teleport already in progress"
    end
    local preferSame = unwrapApiArg(first, second) == true
    local TeleportService = safeGetService("TeleportService")
    if not TeleportService or not LocalPlayer then
        return false, "TeleportService unavailable"
    end
    local placeId = game and tonumber(game.PlaceId) or 0
    if placeId <= 0 then
        return false, "Invalid PlaceId"
    end

    state.teleportBusy = true
    state.teleportBusyUntil = clockNow() + 12
    setBtnLabel(state.rejoinBtn, "Rejoining...")

    armTeleportQueueOnce()
    prepareForTeleport()

    local jobId = game and game.JobId
    local okTp, errTp
    if preferSame and type(jobId) == "string" and jobId ~= "" then
        okTp, errTp = pcall(function()
            TeleportService:TeleportToPlaceInstance(placeId, jobId, LocalPlayer)
        end)
    else
        okTp, errTp = pcall(function()
            TeleportService:Teleport(placeId, LocalPlayer)
        end)
    end

    if okTp then
        if hasRealSpawn and spawnTask then
            spawnTask(function()
                waitTask(8)
                if isActive() and state.teleportBusy then
                    state.teleportBusy = false
                    env.__UniversalLoaderTeleporting = nil
                    refreshControlPanel()
                end
            end)
        else
            state.teleportBusy = false
            env.__UniversalLoaderTeleporting = nil
        end
        return true
    end

    scheduleTeleportUnlock(2, state.rejoinBtn, "Rejoin Failed")
    return false, tostring(errTp)
end

function api.ServerHop(first, second)
    if not isActive() then
        return false, "inactive"
    end
    if state.teleportBusy and clockNow() < state.teleportBusyUntil then
        return false, "Teleport already in progress"
    end
    local preferLowPlayer = unwrapApiArg(first, second) == true
    local HttpService = safeGetService("HttpService")
    local TeleportService = safeGetService("TeleportService")
    if not HttpService or not TeleportService or not LocalPlayer then
        return false, "Teleport/HttpService unavailable"
    end

    local placeId = game and tonumber(game.PlaceId) or 0
    if placeId <= 0 then
        return false, "Invalid PlaceId"
    end

    local activeBtn = preferLowPlayer and state.lowHopBtn or state.hopBtn
    state.teleportBusy = true
    state.teleportBusyUntil = clockNow() + 20
    env.__UniversalLoaderHoppingUntil = clockNow() + 25
    setBtnLabel(activeBtn, "Searching...")

    local sortOrder = preferLowPlayer and "Asc" or "Desc"
    local baseApiUrl = string.format(
        "https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=%s&limit=25",
        math.floor(placeId),
        sortOrder
    )

    local body, fetchErr, httpStatus = fetchUrl(baseApiUrl .. "&excludeFullGames=true", true, 1)
    if not body and httpStatus ~= 429 and httpStatus ~= 403 then
        body, fetchErr, httpStatus = fetchUrl(baseApiUrl, true, 1)
    end
    if not body then
        local failLabel = (httpStatus == 429) and "Rate Limited" or "Fetch Failed"
        scheduleTeleportUnlock(2, activeBtn, failLabel)
        return false, fetchErr or "Failed to fetch servers"
    end

    local okDecode, decoded = pcall(function()
        return HttpService:JSONDecode(body)
    end)
    if not okDecode or type(decoded) ~= "table" or type(decoded.data) ~= "table" then
        scheduleTeleportUnlock(2, activeBtn, "Bad Response")
        return false, "Invalid server list JSON"
    end

    local currentJobId = game and game.JobId or ""
    local candidates = {}
    for _, srv in ipairs(decoded.data) do
        if type(srv) == "table" and type(srv.id) == "string" and srv.id ~= "" and srv.id ~= currentJobId then
            local playing = tonumber(srv.playing) or 0
            local maxPlayers = tonumber(srv.maxPlayers) or math.huge
            if playing > 0 and playing < maxPlayers then
                table.insert(candidates, srv)
            end
        end
    end

    if #candidates == 0 then
        scheduleTeleportUnlock(2, activeBtn, "No Open Servers")
        return false, "No open servers found"
    end

    if preferLowPlayer then
        table.sort(candidates, function(a, b)
            return (tonumber(a.playing) or math.huge) < (tonumber(b.playing) or math.huge)
        end)
    else
        for i = #candidates, 2, -1 do
            local j = math.random(1, i)
            candidates[i], candidates[j] = candidates[j], candidates[i]
        end
    end

    armTeleportQueueOnce()

    local failConn = nil
    if hasRealSpawn and TeleportService.TeleportInitFailed then
        local okSig, conn = pcall(function()
            return TeleportService.TeleportInitFailed:Connect(function(plr, tpResult)
                if plr ~= LocalPlayer or not isActive() then
                    return
                end
                if Enum and Enum.TeleportResult and tpResult == Enum.TeleportResult.IsTeleporting then
                    return
                end
                if failConn then
                    pcall(function() failConn:Disconnect() end)
                    failConn = nil
                end
                env.__UniversalLoaderHoppingUntil = nil
                scheduleTeleportUnlock(2, activeBtn, "Hop Failed")
            end)
        end)
        if okSig and conn then
            failConn = conn
            table.insert(state.connections, conn)
        end
    end

    local chosen = candidates[1]
    setBtnLabel(activeBtn, string.format("Joining (%dp)...", tonumber(chosen.playing) or 0))
    prepareForTeleport()

    local okHop, errHop = pcall(function()
        TeleportService:TeleportToPlaceInstance(placeId, chosen.id, LocalPlayer)
    end)

    if okHop then
        if hasRealSpawn and spawnTask then
            spawnTask(function()
                waitTask(8)
                if isActive() and state.teleportBusy then
                    if failConn then
                        pcall(function() failConn:Disconnect() end)
                        failConn = nil
                    end
                    env.__UniversalLoaderHoppingUntil = nil
                    scheduleTeleportUnlock(0, activeBtn, nil)
                end
            end)
        else
            if failConn then
                pcall(function() failConn:Disconnect() end)
            end
            state.teleportBusy = false
            env.__UniversalLoaderTeleporting = nil
            env.__UniversalLoaderHoppingUntil = nil
        end
        return true, chosen.id
    end

    if failConn then
        pcall(function() failConn:Disconnect() end)
    end
    env.__UniversalLoaderHoppingUntil = nil
    scheduleTeleportUnlock(2, activeBtn, "Hop Failed")
    return false, tostring(errHop)
end

function api.IsPanelVisible()
    return state.panelVisible == true
end

function api.SetPanelVisible(first, second)
    if not isActive() then
        return false
    end
    local visible = unwrapApiArg(first, second) == true
    state.panelVisible = visible
    if visible then
        if not state.panelGui or not state.panelGui.Parent then
            state.panelGui = createControlPanel()
        end
        if state.panelGui then
            pcall(function()
                state.panelGui.Enabled = true
            end)
            refreshControlPanel()
        end
    elseif state.panelGui then
        pcall(function()
            state.panelGui.Enabled = false
        end)
    end
    return state.panelVisible
end

function api.TogglePanel()
    return api.SetPanelVisible(not state.panelVisible)
end

function api.Cleanup()
    state.cleanup()
end
api.Stop = api.Cleanup

state.api = api
env.UniversalLoader = api
if _G and _G ~= env then
    _G.UniversalLoader = api
end

local panelToggleKey = resolveKeyCode(cfg.PanelToggleKey)

-- Arm teleport replay, initial AFK overlay/audio, optional panel, hotkeys & Alt-Tab focus listener
local queueArmed = armTeleportQueueOnce()
if cfg.ShowPanel then
    api.SetPanelVisible(true)
end
if state.manualAfk then
    applyAfkMode()
else
    syncAfkDarkOverlay(false)
end

if UserInputService then
    if (toggleKey or panelToggleKey) and UserInputService.InputBegan then
        trackConnection(UserInputService.InputBegan, function(input, gameProcessed)
            if not isActive() or gameProcessed or not input then
                return
            end
            if toggleKey and input.KeyCode == toggleKey then
                api.ToggleAFK()
            elseif panelToggleKey and input.KeyCode == panelToggleKey then
                api.TogglePanel()
            end
        end)
    end

    if cfg.AutoAFKOnUnfocus then
        if UserInputService.WindowFocusReleased then
            trackConnection(UserInputService.WindowFocusReleased, function()
                if not isActive() or state.focusAfk or state.teleportBusy then
                    return
                end
                state.focusAfk = true
                if not state.manualAfk then
                    applyAfkMode()
                end
            end)
        end
        if UserInputService.WindowFocused then
            trackConnection(UserInputService.WindowFocused, function()
                if not isActive() or not state.focusAfk then
                    return
                end
                state.focusAfk = false
                if not state.manualAfk then
                    applyAfkMode()
                end
            end)
        end
    end
end

local function waitStage(seconds)
    if not isActive() then
        return false
    end
    if cfg.StagedExecution and seconds > 0 then
        waitTask(seconds)
    end
    return isActive()
end

local function runModulesPipeline()
    local loadedModules = {}

    -- 1. Anti-AFK (delayed slightly after script injection)
    if cfg.LoadAntiAFK and waitStage(cfg.AntiAFKDelay) then
        local afkOverride = readUnownedSlot("AntiAFKSettings", "__UniversalLoaderOwnedAFK")
        local finalAfk = mergeTables(afkOverride or {}, cfg.AntiAFKSettings)
        if next(finalAfk) ~= nil then
            writeConfigSlot("AntiAFKSettings", finalAfk)
        end
        if runUrlOrCode(cfg.BaseUrl .. "Anti-AFK", "Anti-AFK") then
            table.insert(loadedModules, "Anti-AFK")
        end
        env.__UniversalLoaderOwnedAFK = env.AntiAFKSettings or (_G and _G.AntiAFKSettings)
    end

    if not isActive() then
        return
    end

    -- 2. Optimizer (runs after Anti-AFK settles, respecting live F8 / Alt-Tab AFK state and MuteAllSounds)
    if cfg.LoadOptimizer and waitStage(cfg.OptimizerDelay) then
        local finalOpt = buildOptimizerSettings(true)
        writeConfigSlot("Settings", finalOpt)
        if runUrlOrCode(cfg.BaseUrl .. "Optimizer", "Optimizer", true) then
            table.insert(loadedModules, "Optimizer")
        end
        env.__UniversalLoaderOwnedOpt = env.Settings or (_G and _G.Settings)
    end

    if not isActive() then
        return
    end

    -- 3. Auto-Reconnect (after Optimizer)
    if cfg.LoadAutoReconnect and waitStage(cfg.AutoReconnectDelay) then
        local userRec = readUnownedSlot("AutoReconnectSettings", "__UniversalLoaderOwnedReconnect")
        local baseRec = {
            QueueOnTeleport = cfg.AutoQueueOnTeleport,
            QueueScript = replayCode,
        }
        local finalRec = mergeTables(baseRec, cfg.AutoReconnectSettings)
        if userRec then
            finalRec = mergeTables(finalRec, userRec)
        end

        writeConfigSlot("AutoReconnectSettings", finalRec)
        if runUrlOrCode(cfg.BaseUrl .. "Auto-Reconnect", "Auto-Reconnect") then
            table.insert(loadedModules, "Auto-Reconnect")
        end
        env.__UniversalLoaderOwnedReconnect = env.AutoReconnectSettings or (_G and _G.AutoReconnectSettings)
    end

    -- 4. Optional user custom scripts / inline code
    local hasExtras = (#cfg.ExtraScripts > 0) or (type(cfg.ExtraCode) == "string" and cfg.ExtraCode ~= "")
    if hasExtras and waitStage(cfg.ExtraScriptsDelay) then
        for idx, scriptEntry in ipairs(cfg.ExtraScripts) do
            if not isActive() then
                break
            end
            if runUrlOrCode(scriptEntry, "ExtraScript#" .. tostring(idx)) then
                table.insert(loadedModules, "Extra#" .. tostring(idx))
            end
        end

        if type(cfg.ExtraCode) == "string" and cfg.ExtraCode ~= "" and isActive() then
            if executeSource(cfg.ExtraCode, "ExtraCode") then
                table.insert(loadedModules, "ExtraCode")
            end
        end
    end

    if isActive() then
        state.stageThread = nil
        notify(
            "Universal Loader",
            string.format("Loaded (%s)%s", tostring(cfg.Preset), queueArmed and " + Queue armed" or "")
        )
        print(string.format(
            "[Universal Loader] Loaded! Preset=%s | Queue=%s | Modules=%s",
            tostring(cfg.Preset),
            queueArmed and "Armed" or "Skipped",
            #loadedModules > 0 and table.concat(loadedModules, ", ") or "None"
        ))
    end
end

if cfg.StagedExecution and spawnTask then
    state.stageThread = spawnTask(runModulesPipeline)
else
    runModulesPipeline()
end

return api
