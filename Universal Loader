local function buildOptimizerSettings(preserveManualToggle)
    local userOpt = readUnownedSlot("Settings", "__UniversalLoaderOwnedOpt")
    local finalOpt = mergeTables(presetBase, cfg.OptimizerSettings)
    if userOpt then
        finalOpt = mergeTables(finalOpt, userOpt)
    end
    finalOpt.Other = finalOpt.Other or {}

    if cfg.MuteAllSounds then
        finalOpt.Other["Mute Sounds"] = true
    end

    local isAfkTarget = (presetKey == "afk") or state.afkRenderDisabled or state.manualAfk
    local explicitCap = tonumber(finalOpt.Other["FPS Cap"])
    if explicitCap and explicitCap > 0 and not (isAfkTarget and (explicitCap == cfg.AFKFPSCap or explicitCap == 5 or explicitCap == 15)) then
        restoredCap = explicitCap
    end

    if preserveManualToggle and (state.afkToggledManually or state.focusAfk) then
        finalOpt.Other["Disable 3D Rendering"] = state.afkRenderDisabled
        if state.afkRenderDisabled then
            finalOpt.Other["FPS Cap"] = cfg.AFKFPSCap
        else
            finalOpt.Other["FPS Cap"] = (restoredCap ~= 999) and restoredCap or false
        end
    elseif finalOpt.Other["Disable 3D Rendering"] ~= nil then
        state.manualAfk = finalOpt.Other["Disable 3D Rendering"] == true
        state.afkRenderDisabled = state.manualAfk or state.focusAfk
    end

    return finalOpt
end

