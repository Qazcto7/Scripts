local handleMeshPart = false
if mpDestroy then
    handleMeshPart = DestroyInstance
elseif mpInvisible or mpLowerQuality or noShadows then
    handleMeshPart = function(inst)
        if mpInvisible then
            inst.Transparency = 1
        end
        if mpLowerQuality then
            if SMOOTH_PLASTIC then
                inst.Material = SMOOTH_PLASTIC
            end
            if inst.Reflectance ~= 0 then
                inst.Reflectance = 0
            end
            if meshPartTextureMode ~= 0 then
                local tid = inst.TextureID
                if tid and tid ~= "" then
                    clearMeshPartTexture(inst)
                end
            end
        end
        if noShadows then
            inst.CastShadow = false
        end
    end
end

