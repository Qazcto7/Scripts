local function resolveHandler(inst, className)
    local resolved = false
    if inst:IsA("Terrain") then
        resolved = false
    elseif inst:IsA("MeshPart") then
        resolved = handleMeshPart
    elseif inst:IsA("BasePart") then
        resolved = handleBasePart
    elseif inst:IsA("DataModelMesh") then
        resolved = (inst:IsA("SpecialMesh") or inst:IsA("FileMesh")) and handleSpecialMesh or handlePrimitiveMesh
    elseif inst:IsA("FaceInstance") then
        resolved = handleImage
    elseif inst:IsA("ParticleEmitter") or inst:IsA("Trail") or inst:IsA("Smoke") or inst:IsA("Fire") or inst:IsA("Sparkles") then
        CAMERA_PASS_CLASSES[className] = true
        resolved = handleParticle
    elseif inst:IsA("Beam") then
        resolved = handleBeam
    elseif inst:IsA("Explosion") then
        CAMERA_PASS_CLASSES[className] = true
        resolved = handleExplosion
    elseif inst:IsA("Clothing") or inst:IsA("ShirtGraphic") or inst:IsA("WrapLayer") or inst:IsA("WrapTarget") then
        resolved = handleClothing
    elseif inst:IsA("PostEffect") then
        LIGHTING_CLASSES[className] = true
        CAMERA_PASS_CLASSES[className] = true
        resolved = handlePostEffect
    elseif inst:IsA("Atmosphere") then
        LIGHTING_CLASSES[className] = true
        resolved = handleAtmosphereActive
    elseif inst:IsA("Clouds") then
        LIGHTING_CLASSES[className] = true
        resolved = handleCloudsActive
    elseif inst:IsA("Light") then
        resolved = handleLightActive
    elseif inst:IsA("Highlight") then
        resolved = handleHighlight
    elseif inst:IsA("SurfaceAppearance") then
        resolved = handleSurfaceAppearance
    elseif inst:IsA("BillboardGui") then
        resolved = handleBillboardUI
    elseif inst:IsA("SurfaceGui") then
        resolved = handleSurfaceUI
    elseif inst:IsA("VideoFrame") then
        resolved = handleVideo
    elseif inst:IsA("Sound") then
        resolved = handleSoundActive
    elseif inst:IsA("SoundGroup") then
        resolved = handleSoundGroupActive
    end

    CLASS_HANDLERS[className] = resolved
    return resolved
end

local function optimizeInstanceUnsafe(inst)
    local className = inst.ClassName
    local handler = CLASS_HANDLERS[className]
    if handler == nil then
        handler = resolveHandler(inst, className)
    end
    if not handler then
        return false
    end

    local parent = inst.Parent
    if not parent then
        return false
    end

    if isIgnoredDynamic(inst, parent, className) then
        return false
    end

    handler(inst)
    return true
end

local function optimizeInstance(inst)
    if not inst then
        return false
    end
    local ok, res = pcall(optimizeInstanceUnsafe, inst)
    return ok and res == true
end

local function applyTerrainSettings(terrain)
    if not terrain then
        return
    end
    if lowWater then
        setPropSafe(terrain, "WaterWaveSize", 0)
        setPropSafe(terrain, "WaterWaveSpeed", 0)
        setPropSafe(terrain, "WaterReflectance", 0)
        setPropSafe(terrain, "WaterTransparency", 0)
    end
    if (lowWater or lowQualityParts) and setHiddenProp then
        pcall(setHiddenProp, terrain, "Decoration", false)
    end
    if noShadows then
        setPropSafe(terrain, "CastShadow", false)
    end
end

local function applyFFlag(flagName, value)
    if applyFFlags and setFFlagFn then
        pcall(setFFlagFn, flagName, tostring(value))
    end
end

local function applyGlobalSettings()
    if noShadows then
        setPropSafe(Lighting, "GlobalShadows", false)
        setPropSafe(Lighting, "ShadowSoftness", 0)
        if setHiddenProp and VOXEL_TECH then
            pcall(setHiddenProp, Lighting, "Technology", VOXEL_TECH)
        end
        applyFFlag("FIntRenderShadowIntensity", 0)
    end

    if noFog then
        setPropSafe(Lighting, "FogEnd", 9e9)
    end

    if lowQualityParts or lowRendering then
        setPropSafe(Lighting, "EnvironmentSpecularScale", 0)
        setPropSafe(Lighting, "EnvironmentDiffuseScale", 0)
        if MaterialService then
            setPropSafe(MaterialService, "Use2022Materials", false)
        end
    end

    if lowRendering then
        pcall(function()
            local rs = settings().Rendering
            if LOW_RENDER_QUALITY then
                rs.QualityLevel = LOW_RENDER_QUALITY
                setPropSafe(rs, "EditQualityLevel", LOW_RENDER_QUALITY)
            end
            if LOW_MESH_DETAIL then
                setPropSafe(rs, "MeshPartDetailLevel", LOW_MESH_DETAIL)
            end
        end)
        pcall(function()
            local gs = UserSettings():GetService("UserGameSettings")
            if gs and SAVED_LOW_QUALITY then
                setPropSafe(gs, "SavedQualityLevel", SAVED_LOW_QUALITY)
            end
        end)
        applyFFlag("FFlagDisablePostFx", "True")
        applyFFlag("DFIntDebugFRMQualityLevelOverride", 1)
        applyFFlag("DFFlagTextureQualityOverrideEnabled", "True")
        applyFFlag("DFIntTextureQualityOverride", 0)
    end

    if type(RunService.Set3dRenderingEnabled) == "function" then
        pcall(RunService.Set3dRenderingEnabled, RunService, not disable3DRendering)
    end

    if optimizePhysics then
        pcall(function()
            local ps = settings().Physics
            if ps then
                setPropSafe(ps, "AllowSleep", true)
                local throttleEnum = resolvePhysicsThrottleEnum(physicsThrottle)
                if throttleEnum then
                    setPropSafe(ps, "PhysicsEnvironmentalThrottle", throttleEnum)
                end
            end
        end)
        if INTERPOLATION_ENABLED then
            setPropSafe(Workspace, "InterpolationThrottling", INTERPOLATION_ENABLED)
        end
    end

    if optimizeNetwork then
        pcall(function()
            local ns = settings().Network
            if ns then
                setPropSafe(ns, "IncomingReplicationLag", 0)
            end
        end)
        applyFFlag("FFlagOptimizeNetworkTransport", "True")
        applyFFlag("DFIntConnectionMTUSize", 1400)
    end

    if muteSounds then
        pcall(function()
            local gs = UserSettings():GetService("UserGameSettings")
            if gs then
                setPropSafe(gs, "MasterVolume", 0)
            end
        end)
    end

    if fpsCap then
        local capNum = tonumber(fpsCap)
        if capNum and capNum > 0 then
            if setFpsCap then
                pcall(setFpsCap, capNum)
            end
            applyFFlag("DFIntTaskSchedulerTargetFps", math.floor(capNum))
        elseif fpsCap == true then
            if setFpsCap then
                pcall(setFpsCap, 999)
            end
            applyFFlag("DFIntTaskSchedulerTargetFps", 999)
        end
    end

    local function getTerrainSafe()
        local okProp, propVal = pcall(function()
            return Workspace.Terrain
        end)
        if okProp and propVal then
            return propVal
        end
        local okFind, found = pcall(Workspace.FindFirstChildOfClass, Workspace, "Terrain")
        if okFind then
            return found
        end
        return nil
    end

    local terrain = getTerrainSafe()
    if terrain then
        applyTerrainSettings(terrain)
    elseif type(Workspace.GetPropertyChangedSignal) == "function" then
        local ok, sig = pcall(Workspace.GetPropertyChangedSignal, Workspace, "Terrain")
        if ok and sig then
            local terrainConn
            terrainConn = trackConnection(sig:Connect(function()
                local t = getTerrainSafe()
                if t then
                    applyTerrainSettings(t)
                    disconnectConn(terrainConn)
                end
            end))
        end
    end
end

-- Dynamic optimization queue with strict per-frame time budget
local INITIAL_FRAME_BUDGET = 0.004 -- 4ms per frame during initial pass
local DYNAMIC_FRAME_BUDGET = 0.002 -- 2ms per frame during gameplay
local SLICE_BATCH = 256
local clock = os.clock

local function enqueueInstance(inst)
    if isCleanedUp or not inst then
        return
    end
    local ok, className = pcall(readClassName, inst)
    if not ok or CLASS_HANDLERS[className] == false then
        return
    end
    if not pendingSet[inst] then
        pendingSet[inst] = true
        queueTail = queueTail + 1
        pendingQueue[queueTail] = inst
    end
end

local function enqueueLightingInstance(inst)
    if isCleanedUp or not inst then
        return
    end
    local ok, className = pcall(readClassName, inst)
    if not ok then
        return
    end
    local handler = CLASS_HANDLERS[className]
    if handler == false or (handler ~= nil and not LIGHTING_CLASSES[className]) then
        return
    end
    if not pendingSet[inst] then
        pendingSet[inst] = true
        queueTail = queueTail + 1
        pendingQueue[queueTail] = inst
    end
end

-- Keep cachedCamera synchronized even if dynamicOptimize is disabled
if type(Workspace.GetPropertyChangedSignal) == "function" then
    local ok, sig = pcall(Workspace.GetPropertyChangedSignal, Workspace, "CurrentCamera")
    if ok and sig then
        trackConnection(sig:Connect(function()
            local cam = Workspace.CurrentCamera
            cachedCamera = cam
            if activeCamAncestors then
                activeCamAncestors = cam and { [cam] = true } or {}
            end
            if activeSafeAncestors then
                activeSafeAncestors = { [Workspace] = true }
            end
            if dynamicOptimize and cam and isActive() then
                local okDesc, camDescendants = pcall(cam.GetDescendants, cam)
                if okDesc and type(camDescendants) == "table" then
                    for i = 1, #camDescendants do
                        enqueueInstance(camDescendants[i])
                    end
                end
            end
        end))
    end
end

if dynamicOptimize then
    trackConnection(Workspace.DescendantAdded:Connect(enqueueInstance))
    trackConnection(Lighting.DescendantAdded:Connect(enqueueLightingInstance))

    trackConnection(RunService.Heartbeat:Connect(function()
        if isCleanedUp or queueHead > queueTail or not isActive() then
            return
        end
        local sliceStart = clock()
        local processed = 0
        while queueHead <= queueTail do
            local inst = pendingQueue[queueHead]
            pendingQueue[queueHead] = nil
            queueHead = queueHead + 1
            if inst then
                pendingSet[inst] = nil
                optimizeInstance(inst)
            end
            processed = processed + 1
            if processed % 64 == 0 and (clock() - sliceStart) >= DYNAMIC_FRAME_BUDGET then
                break
            end
        end
        if queueHead > queueTail then
            queueHead = 1
            queueTail = 0
        end
    end))
end

applyGlobalSettings()

local function scanContainer(container, budget)
    local okDesc, descendants = pcall(container.GetDescendants, container)
    if not okDesc or type(descendants) ~= "table" then
        return 0, 0, 0
    end
    local total = #descendants
    if total == 0 then
        return 0, 0, 0
    end

    local isLighting = (container == Lighting)
    local optimized = 0
    local workTime = 0

    local safeAncestors = nil
    local ignoredAncestors = nil
    local camAncestors = nil
    local ancestorTrail = nil

    if not isLighting and checkPlayers then
        syncAllPlayerCharacters()
        safeAncestors = { [Workspace] = true }
        ignoredAncestors = {}
        for char in pairs(IgnoredCharacters) do
            ignoredAncestors[char] = true
        end
        camAncestors = {}
        cachedCamera = Workspace.CurrentCamera
        if cachedCamera then
            camAncestors[cachedCamera] = true
        end
        activeSafeAncestors = safeAncestors
        activeIgnoredAncestors = ignoredAncestors
        activeCamAncestors = camAncestors
        ancestorTrail = {}
    end

    local function clearTrail(count)
        for k = 1, count do
            ancestorTrail[k] = nil
        end
    end

    local function resolveAncestorIgnored(parent, className)
        local trailCount = 0
        local node = parent
        local verdict = -1 -- -1 = detached, 0 = safe, 1 = ignored, 2 = camera
        while node do
            if safeAncestors[node] or node == Workspace or node == game then
                verdict = 0
                break
            end
            if ignoredAncestors[node] or IgnoredCharacters[node] then
                verdict = 1
                break
            end
            if cachedCamera and (node == cachedCamera or camAncestors[node]) then
                verdict = 2
                break
            end
            if node == Lighting then
                clearTrail(trailCount)
                return not LIGHTING_CLASSES[className]
            end
            trailCount = trailCount + 1
            ancestorTrail[trailCount] = node
            node = node.Parent
        end

        if verdict == 0 then
            for k = 1, trailCount do
                safeAncestors[ancestorTrail[k]] = true
                ancestorTrail[k] = nil
            end
            return false
        elseif verdict == 1 then
            for k = 1, trailCount do
                ignoredAncestors[ancestorTrail[k]] = true
                ancestorTrail[k] = nil
            end
            return true
        elseif verdict == 2 then
            for k = 1, trailCount do
                camAncestors[ancestorTrail[k]] = true
                ancestorTrail[k] = nil
            end
            return ignoreMe and not CAMERA_PASS_CLASSES[className]
        end

        clearTrail(trailCount)
        return true
    end

    local chunkStart = 1
    local chunkIdx = 1
    local processChunk

    if isLighting then
        processChunk = function(stopIdx)
            for j = chunkStart, stopIdx do
                chunkIdx = j
                local inst = descendants[j]
                if inst then
                    local className = inst.ClassName
                    local handler = CLASS_HANDLERS[className]
                    if handler == nil then
                        handler = resolveHandler(inst, className)
                    end
                    if handler and LIGHTING_CLASSES[className] and inst.Parent then
                        handler(inst)
                        optimized = optimized + 1
                    end
                end
            end
        end
    elseif checkPlayers then
        processChunk = function(stopIdx)
            for j = chunkStart, stopIdx do
                chunkIdx = j
                local inst = descendants[j]
                if inst then
                    local className = inst.ClassName
                    local handler = CLASS_HANDLERS[className]
                    if handler == nil then
                        handler = resolveHandler(inst, className)
                    end
                    if handler then
                        local parent = inst.Parent
                        if parent and not IgnoredCharacters[inst] then
                            if safeAncestors[parent] then
                                handler(inst)
                                optimized = optimized + 1
                            elseif ignoredAncestors[parent] then
                                -- Ignored character descendant
                            elseif ignoreMe and camAncestors[parent] then
                                if CAMERA_PASS_CLASSES[className] then
                                    handler(inst)
                                    optimized = optimized + 1
                                end
                            elseif not resolveAncestorIgnored(parent, className) then
                                handler(inst)
                                optimized = optimized + 1
                            end
                        end
                    end
                end
            end
        end
    else
        processChunk = function(stopIdx)
            for j = chunkStart, stopIdx do
                chunkIdx = j
                local inst = descendants[j]
                if inst then
                    local className = inst.ClassName
                    local handler = CLASS_HANDLERS[className]
                    if handler == nil then
                        handler = resolveHandler(inst, className)
                    end
                    if handler and inst.Parent then
                        handler(inst)
                        optimized = optimized + 1
                    end
                end
            end
        end
    end

    local sliceStart = clock()
    local i = 1
    while i <= total do
        local stopIdx = i + SLICE_BATCH - 1
        if stopIdx > total then
            stopIdx = total
        end
        chunkStart = i
        chunkIdx = i
        local ok = pcall(processChunk, stopIdx)
        if ok then
            i = stopIdx + 1
        else
            if ancestorTrail then
                for k = 1, #ancestorTrail do
                    ancestorTrail[k] = nil
                end
            end
            i = (chunkIdx >= chunkStart and chunkIdx or chunkStart) + 1
        end

        local now = clock()
        local elapsed = now - sliceStart
        if elapsed >= budget then
            workTime = workTime + elapsed
            waitTask()
            if not isActive() then
                if not isLighting and checkPlayers then
                    activeSafeAncestors = nil
                    activeIgnoredAncestors = nil
                    activeCamAncestors = nil
                end
                return total, optimized, workTime
            end
            if not isLighting and checkPlayers then
                safeAncestors = activeSafeAncestors or safeAncestors
                ignoredAncestors = activeIgnoredAncestors or ignoredAncestors
                camAncestors = activeCamAncestors or camAncestors
            end
            sliceStart = clock()
        end
    end

    workTime = workTime + (clock() - sliceStart)
    if not isLighting and checkPlayers then
        activeSafeAncestors = nil
        activeIgnoredAncestors = nil
        activeCamAncestors = nil
    end
    return total, optimized, workTime
end

-- Apply top-level Lighting & CurrentCamera immediately so visual effects disappear on frame 1
local okLightChildren, lightingChildren = pcall(Lighting.GetChildren, Lighting)
if okLightChildren and type(lightingChildren) == "table" then
    for i = 1, #lightingChildren do
        optimizeInstance(lightingChildren[i])
    end
end
if cachedCamera then
    local okCamDesc, camDescendants = pcall(cachedCamera.GetDescendants, cachedCamera)
    if okCamDesc and type(camDescendants) == "table" then
        for i = 1, #camDescendants do
            optimizeInstance(camDescendants[i])
        end
    end
end

