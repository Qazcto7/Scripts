local function resolvePhysicsThrottleEnum(mode)
    if type(mode) ~= "string" then
        return nil
    end
    local key = string.lower(mode)
    local map = {
        auto = "DefaultAuto",
        defaultauto = "DefaultAuto",
        skip2 = "Skip2",
        skip4 = "Skip4",
        skip8 = "Skip8",
        skip16 = "Skip16",
        always = "Always",
        disabled = "Disabled",
    }
    local enumName = map[key]
    if not enumName then
        return nil
    end
    return tryGetEnum(function()
        local e = Enum.EnviromentalPhysicsThrottle or Enum.EnvironmentalPhysicsThrottle
        return e[enumName]
    end)
end

