-- Weak-keyed caches avoid retaining destroyed models in memory
local IgnoredCharacters = setmetatable({}, { __mode = "k" })
local NonPlayerModels = setmetatable({}, { __mode = "k" })

local function updateCharacterCache(player, char)
    if not char then
        return
    end
    NonPlayerModels[char] = nil
    local ignore = (player == LocalPlayer and ignoreMe) or (player ~= LocalPlayer and ignoreOthers)
    IgnoredCharacters[char] = ignore or nil
end

local function hookPlayer(player)
    disconnectPlayer(player)
    local list = {}
    playerConnections[player] = list

    local lastChar = player.Character
    updateCharacterCache(player, lastChar)

    local function syncCharacter(char)
        if lastChar and lastChar ~= char then
            IgnoredCharacters[lastChar] = nil
        end
        lastChar = char
        updateCharacterCache(player, char)
    end

    list[#list + 1] = player.CharacterAdded:Connect(syncCharacter)
    list[#list + 1] = player.CharacterRemoving:Connect(function(char)
        IgnoredCharacters[char] = nil
        if lastChar == char then
            lastChar = nil
        end
    end)
    if type(player.GetPropertyChangedSignal) == "function" then
        local ok, sig = pcall(player.GetPropertyChangedSignal, player, "Character")
        if ok and sig then
            list[#list + 1] = sig:Connect(function()
                syncCharacter(player.Character)
            end)
        end
    end
end

if ignoreMe or ignoreOthers then
    local existingPlayers = Players:GetPlayers()
    for i = 1, #existingPlayers do
        hookPlayer(existingPlayers[i])
    end
    trackConnection(Players.PlayerAdded:Connect(hookPlayer))
    trackConnection(Players.PlayerRemoving:Connect(function(player)
        if player.Character then
            IgnoredCharacters[player.Character] = nil
        end
        disconnectPlayer(player)
    end))
end

