local function disconnectConn(conn)
    if not conn then
        return
    end
    pcall(function()
        conn:Disconnect()
    end)
end

-- State & cleanup management for safe re-execution
local connections = {}
local playerConnections = {}
local pendingQueue = {}
local pendingSet = setmetatable({}, { __mode = "k" })
local queueHead = 1
local queueTail = 0
local scanThread = nil
local isCleanedUp = false

local state = {
    runId = runId,
}

local function isActive()
    return (not isCleanedUp) and env.__OptimizerState == state and env.__OptimizerRunId == runId
end

local function trackConnection(conn)
    if conn then
        connections[#connections + 1] = conn
    end
    return conn
end

local function disconnectPlayer(player)
    local list = playerConnections[player]
    if list then
        for i = 1, #list do
            disconnectConn(list[i])
        end
        playerConnections[player] = nil
    end
end

state.cleanup = function()
    if isCleanedUp then
        return
    end
    isCleanedUp = true
    for i = #connections, 1, -1 do
        disconnectConn(connections[i])
        connections[i] = nil
    end
    for player in pairs(playerConnections) do
        disconnectPlayer(player)
    end
    if scanThread and cancelTask then
        pcall(cancelTask, scanThread)
    end
    scanThread = nil
    pendingQueue = {}
    pendingSet = setmetatable({}, { __mode = "k" })
    queueHead = 1
    queueTail = 0
end

env.__OptimizerState = state

