local handleBillboardUI = false
local handleSurfaceUI = false
local worldUILightZero = lowRendering or lowQualityParts
local surfaceGuiHasMaxDist = nil -- nil = untested, true/false after first SurfaceGui

if disableWorldUI then
    handleBillboardUI = handleDisableEnabled
    handleSurfaceUI = handleDisableEnabled
elseif optimizeWorldUI == true then
    handleBillboardUI = function(inst)
        local dist = inst.MaxDistance
        if dist == 0 or dist > maxWorldUIDistance then
            inst.MaxDistance = maxWorldUIDistance
        end
        if worldUILightZero then
            inst.LightInfluence = 0
        end
    end
    handleSurfaceUI = function(inst)
        if surfaceGuiHasMaxDist ~= false then
            if surfaceGuiHasMaxDist == true then
                local dist = inst.MaxDistance
                if dist == 0 or dist > maxWorldUIDistance then
                    inst.MaxDistance = maxWorldUIDistance
                end
            else
                local okDist, dist = pcall(readMaxDistance, inst)
                if okDist and type(dist) == "number" then
                    surfaceGuiHasMaxDist = true
                    if dist == 0 or dist > maxWorldUIDistance then
                        setPropSafe(inst, "MaxDistance", maxWorldUIDistance)
                    end
                elseif inst.Parent ~= nil then
                    surfaceGuiHasMaxDist = false
                end
            end
        end
        if worldUILightZero then
            inst.LightInfluence = 0
        end
    end
end

