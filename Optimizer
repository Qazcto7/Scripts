local function isIgnored(inst, className)
    local cam = Workspace.CurrentCamera
    local node = inst

    while node and node ~= Workspace and node ~= Lighting and node ~= game do
        if cam and node == cam then
            -- Keep first-person viewmodel meshes/parts/decals intact when Ignore Me is true
            if ignoreMe and not CAMERA_PASS_CLASSES[className] then
                return true
            end
        end
        if (ignoreMe or ignoreOthers) and IgnoredCharacters[node] then
            return true
        end
        if (ignoreMe or ignoreOthers) and node.ClassName == "Model" and not NonPlayerModels[node] then
            local okPlr, plr = pcall(Players.GetPlayerFromCharacter, Players, node)
            if okPlr and plr then
                local ignore = (plr == LocalPlayer and ignoreMe) or (plr ~= LocalPlayer and ignoreOthers)
                if ignore then
                    IgnoredCharacters[node] = true
                    return true
                end
                return false
            else
                NonPlayerModels[node] = true
            end
        end
        node = node.Parent
    end

    if node == Lighting and not LIGHTING_CLASSES[className] then
        return true
    end

    return false
end

-- Per-class handlers (no per-instance closure allocation)
local function handleMeshPart(inst)
    if mpDestroy then
        destroySafe(inst)
        return
    end
    if mpInvisible and inst.Transparency ~= 1 then
        inst.Transparency = 1
    end
    if mpLowerQuality then
        if SMOOTH_PLASTIC and inst.Material ~= SMOOTH_PLASTIC then
            inst.Material = SMOOTH_PLASTIC
        end
        if inst.Reflectance ~= 0 then
            inst.Reflectance = 0
        end
        if inst.TextureID ~= "" then
            pcall(setPropSafe, inst, "TextureID", "")
        end
    end
    if noShadows and inst.CastShadow then
        inst.CastShadow = false
    end
end

-- Note: RenderFidelity on MeshPart and PartOperation/SolidModel is skipped at runtime because Roblox logs "Cannot change SolidModel RenderFidelity during Run-Time" even under pcall.
local function handleBasePart(inst)
    if lowQualityParts then
        if SMOOTH_PLASTIC and inst.Material ~= SMOOTH_PLASTIC then
            inst.Material = SMOOTH_PLASTIC
        end
        if inst.Reflectance ~= 0 then
            inst.Reflectance = 0
        end
    end
    if noShadows and inst.CastShadow then
        inst.CastShadow = false
    end
end

local function handleMesh(inst)
    if meshDestroy then
        destroySafe(inst)
    elseif meshLowDetail and setHiddenProp and LOW_LOD then
        pcall(setHiddenProp, inst, "LODX", LOW_LOD)
        pcall(setHiddenProp, inst, "LODY", LOW_LOD)
    end
end

local function handleImage(inst)
    if imgDestroy then
        destroySafe(inst)
    elseif imgInvisible and inst.Transparency ~= 1 then
        inst.Transparency = 1
    end
end

local function handleParticle(inst)
    if partDestroy then
        destroySafe(inst)
    elseif partInvisible and inst.Enabled then
        inst.Enabled = false
    end
end

local function handleBeam(inst)
    if not noBeams then
        return
    end
    if partDestroy then
        destroySafe(inst)
    elseif inst.Enabled then
        inst.Enabled = false
    end
end

local function handleExplosion(inst)
    if expDestroy then
        destroySafe(inst)
        return
    end
    if expInvisible and inst.Visible then
        inst.Visible = false
    end
    if expSmaller then
        if inst.BlastPressure ~= 1 then
            inst.BlastPressure = 1
        end
        if inst.BlastRadius ~= 1 then
            inst.BlastRadius = 1
        end
    end
end

local function handleClothing(inst)
    if noClothes then
        destroySafe(inst)
    end
end

local function handlePostEffect(inst)
    if noCameraEffects and inst.Enabled then
        inst.Enabled = false
    end
end

local function handleAtmosphere(inst)
    if noFog or noCameraEffects then
        if inst.Density ~= 0 then
            pcall(setPropSafe, inst, "Density", 0)
        end
        if inst.Glare ~= 0 then
            pcall(setPropSafe, inst, "Glare", 0)
        end
        if inst.Haze ~= 0 then
            pcall(setPropSafe, inst, "Haze", 0)
        end
    end
end

local function handleClouds(inst)
    if noClouds and inst.Enabled then
        inst.Enabled = false
    end
end

local function handleLight(inst)
    if noShadows and inst.Shadows then
        inst.Shadows = false
    end
end

local function handleSurfaceAppearance(inst)
    if noSurfaceAppearance then
        destroySafe(inst)
    end
end

local function handleHighlight(inst)
    if noHighlights and inst.Enabled then
        pcall(setPropSafe, inst, "Enabled", false)
    end
end

local function handleVideoFrame(inst)
    if disableVideoFrames then
        pcall(function()
            if inst.Playing then
                inst.Playing = false
            end
            if inst.Visible then
                inst.Visible = false
            end
        end)
    end
end

local function handleSound(inst)
    if not muteSounds then
        return
    end
    local okVol, vol = pcall(function()
        return inst.Volume
    end)
    if okVol and type(vol) == "number" and vol ~= 0 then
        setPropSafe(inst, "Volume", 0)
    end
    local okPlay, playing = pcall(function()
        return inst.Playing
    end)
    if okPlay and playing == true then
        setPropSafe(inst, "Playing", false)
    end
end

local function handleWorldUI(inst)
    if disableWorldUI then
        if inst.Enabled then
            pcall(setPropSafe, inst, "Enabled", false)
        end
        return
    end
    if optimizeWorldUI == true then
        local okDist, dist = pcall(function()
            return inst.MaxDistance
        end)
        if okDist and type(dist) == "number" and (dist == 0 or dist > maxWorldUIDistance) then
            pcall(setPropSafe, inst, "MaxDistance", maxWorldUIDistance)
        end
        if lowRendering or lowQualityParts then
            local okLight, li = pcall(function()
                return inst.LightInfluence
            end)
            if okLight and type(li) == "number" and li ~= 0 then
                pcall(setPropSafe, inst, "LightInfluence", 0)
            end
        end
    end
end

