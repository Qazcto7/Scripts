local function mergeDefaults(defaults, overrides)
    overrides = type(overrides) == "table" and overrides or {}
    local result = {}
    for key, default in pairs(defaults) do
        local override = overrides[key]
        if type(default) == "table" then
            result[key] = mergeDefaults(default, type(override) == "table" and override or nil)
        elseif override ~= nil then
            result[key] = override
        else
            result[key] = default
        end
    end
    return result
end

local function readUserSettings()
    if type(_G.Settings) == "table" then
        return _G.Settings
    end
    if type(getgenv) == "function" then
        local genv = getgenv()
        if type(genv) == "table" and type(genv.Settings) == "table" then
            return genv.Settings
        end
    end
    return nil
end

