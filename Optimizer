local function isIgnoredDynamic(inst, parent, className)
    if checkPlayers and IgnoredCharacters[inst] then
        return true
    end
    local cam = cachedCamera
    local node = parent

    while node and node ~= Workspace and node ~= Lighting and node ~= game do
        if ignoreMe and cam and node == cam then
            -- Keep first-person viewmodel meshes/parts/decals intact when Ignore Me is true
            if not CAMERA_PASS_CLASSES[className] then
                return true
            end
        end
        if checkPlayers and IgnoredCharacters[node] then
            return true
        end
        node = node.Parent
    end

    if node == Lighting and not LIGHTING_CLASSES[className] then
        return true
    end

    return false
end

-- Forward-declared unified class dispatch table:
--   function = active handler
--   false    = known skipped / disabled class (O(1) single-lookup skip)
--   nil      = unseen class (resolved lazily once via resolveHandler)
