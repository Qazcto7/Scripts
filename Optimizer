-- Capability probes (probe once instead of throwing C++ exceptions on thousands of instances)
-- meshPartTextureMode: nil = untested, 1 = direct assign, 2 = sethiddenproperty, 0 = unsupported
local meshPartTextureMode = nil
local function clearMeshPartTexture(inst)
    if meshPartTextureMode == 1 then
        inst.TextureID = ""
        return
    elseif meshPartTextureMode == 2 then
        setHiddenProp(inst, "TextureID", "")
        return
    elseif meshPartTextureMode == 0 then
        return
    end

    local okDirect = pcall(rawAssignProp, inst, "TextureID", "")
    if okDirect then
        meshPartTextureMode = 1
        return
    end
    if setHiddenProp then
        local okHidden = pcall(setHiddenProp, inst, "TextureID", "")
        if okHidden then
            meshPartTextureMode = 2
            return
        end
    end
    if inst.Parent ~= nil then
        meshPartTextureMode = 0
    end
end

local meshLodSupported = (not meshDestroy) and meshLowDetail and (setHiddenProp ~= nil) and (LOW_LOD ~= nil)
local meshLodProbed = false
local meshLodHasX = false
local meshLodHasY = false

local function handleMeshLod(inst)
    if not meshLodSupported then
        return
    end
    if not meshLodProbed then
        local okX = pcall(setHiddenProp, inst, "LODX", LOW_LOD)
        local okY = pcall(setHiddenProp, inst, "LODY", LOW_LOD)
        if okX or okY then
            meshLodProbed = true
            meshLodHasX = okX
            meshLodHasY = okY
        elseif inst.Parent ~= nil then
            meshLodSupported = false
            CLASS_HANDLERS.SpecialMesh = false
            CLASS_HANDLERS.FileMesh = false
        end
        return
    end
    if meshLodHasX then
        setHiddenProp(inst, "LODX", LOW_LOD)
    end
    if meshLodHasY then
        setHiddenProp(inst, "LODY", LOW_LOD)
    end
end

