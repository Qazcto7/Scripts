local function resolveHandler(inst, className)
    if inst:IsA("Terrain") then
        SKIP_CLASSES[className] = true
        return nil
    elseif inst:IsA("MeshPart") then
        CLASS_HANDLERS[className] = handleMeshPart
        return handleMeshPart
    elseif inst:IsA("BasePart") then
        CLASS_HANDLERS[className] = handleBasePart
        return handleBasePart
    elseif inst:IsA("DataModelMesh") then
        CLASS_HANDLERS[className] = handleMesh
        return handleMesh
    elseif inst:IsA("FaceInstance") then
        CLASS_HANDLERS[className] = handleImage
        return handleImage
    elseif inst:IsA("ParticleEmitter") or inst:IsA("Trail") or inst:IsA("Smoke") or inst:IsA("Fire") or inst:IsA("Sparkles") then
        CLASS_HANDLERS[className] = handleParticle
        CAMERA_PASS_CLASSES[className] = true
        return handleParticle
    elseif inst:IsA("Beam") then
        CLASS_HANDLERS[className] = handleBeam
        return handleBeam
    elseif inst:IsA("Explosion") then
        CLASS_HANDLERS[className] = handleExplosion
        CAMERA_PASS_CLASSES[className] = true
        return handleExplosion
    elseif inst:IsA("Clothing") or inst:IsA("ShirtGraphic") or inst:IsA("WrapLayer") or inst:IsA("WrapTarget") then
        CLASS_HANDLERS[className] = handleClothing
        return handleClothing
    elseif inst:IsA("PostEffect") then
        CLASS_HANDLERS[className] = handlePostEffect
        LIGHTING_CLASSES[className] = true
        CAMERA_PASS_CLASSES[className] = true
        return handlePostEffect
    elseif inst:IsA("Atmosphere") then
        CLASS_HANDLERS[className] = handleAtmosphere
        LIGHTING_CLASSES[className] = true
        return handleAtmosphere
    elseif inst:IsA("Clouds") then
        CLASS_HANDLERS[className] = handleClouds
        LIGHTING_CLASSES[className] = true
        return handleClouds
    elseif inst:IsA("Light") then
        CLASS_HANDLERS[className] = handleLight
        return handleLight
    elseif inst:IsA("Highlight") then
        CLASS_HANDLERS[className] = handleHighlight
        return handleHighlight
    elseif inst:IsA("SurfaceAppearance") then
        CLASS_HANDLERS[className] = handleSurfaceAppearance
        return handleSurfaceAppearance
    elseif inst:IsA("BillboardGui") or inst:IsA("SurfaceGui") then
        CLASS_HANDLERS[className] = handleWorldUI
        return handleWorldUI
    elseif inst:IsA("VideoFrame") then
        CLASS_HANDLERS[className] = handleVideoFrame
        return handleVideoFrame
    elseif inst:IsA("Sound") or inst:IsA("SoundGroup") then
        if muteSounds then
            CLASS_HANDLERS[className] = handleSound
            return handleSound
        end
        SKIP_CLASSES[className] = true
        return nil
    end

    SKIP_CLASSES[className] = true
    return nil
end

local function optimizeInstanceUnsafe(inst)
    if not inst or not inst.Parent then
        return false
    end
    local className = inst.ClassName
    if SKIP_CLASSES[className] then
        return false
    end

    local handler = CLASS_HANDLERS[className]
    if not handler then
        handler = resolveHandler(inst, className)
        if not handler then
            return false
        end
    end

    if isIgnored(inst, className) then
        return false
    end

    handler(inst)
    return true
end

local function optimizeInstance(inst)
    if not inst then
        return false
    end
    local ok, res = pcall(optimizeInstanceUnsafe, inst)
    return ok and res == true
end

local function applyTerrainSettings(terrain)
    if not terrain then
        return
    end
    if lowWater then
        pcall(setPropSafe, terrain, "WaterWaveSize", 0)
        pcall(setPropSafe, terrain, "WaterWaveSpeed", 0)
        pcall(setPropSafe, terrain, "WaterReflectance", 0)
        pcall(setPropSafe, terrain, "WaterTransparency", 0)
    end
    if (lowWater or lowQualityParts) and setHiddenProp then
        pcall(setHiddenProp, terrain, "Decoration", false)
    end
    if noShadows then
        pcall(setPropSafe, terrain, "CastShadow", false)
    end
end

local function applyFFlag(flagName, value)
    if applyFFlags and setFFlagFn then
        pcall(setFFlagFn, flagName, tostring(value))
    end
end

local function applyGlobalSettings()
    if noShadows then
        pcall(setPropSafe, Lighting, "GlobalShadows", false)
        pcall(setPropSafe, Lighting, "ShadowSoftness", 0)
        if setHiddenProp and VOXEL_TECH then
            pcall(setHiddenProp, Lighting, "Technology", VOXEL_TECH)
        end
        applyFFlag("FIntRenderShadowIntensity", 0)
    end

    if noFog then
        pcall(setPropSafe, Lighting, "FogEnd", 9e9)
    end

    if lowQualityParts or lowRendering then
        pcall(setPropSafe, Lighting, "EnvironmentSpecularScale", 0)
        pcall(setPropSafe, Lighting, "EnvironmentDiffuseScale", 0)
        if MaterialService then
            pcall(setPropSafe, MaterialService, "Use2022Materials", false)
        end
    end

    if lowRendering then
        pcall(function()
            local rs = settings().Rendering
            if LOW_RENDER_QUALITY then
                rs.QualityLevel = LOW_RENDER_QUALITY
                pcall(setPropSafe, rs, "EditQualityLevel", LOW_RENDER_QUALITY)
            end
            if LOW_MESH_DETAIL then
                pcall(setPropSafe, rs, "MeshPartDetailLevel", LOW_MESH_DETAIL)
            end
            pcall(setPropSafe, rs, "EagerBulkExecution", false)
        end)
        pcall(function()
            local gs = UserSettings():GetService("UserGameSettings")
            if gs and SAVED_LOW_QUALITY then
                pcall(setPropSafe, gs, "SavedQualityLevel", SAVED_LOW_QUALITY)
            end
        end)
        applyFFlag("FFlagDisablePostFx", "True")
        applyFFlag("DFIntDebugFRMQualityLevelOverride", 1)
        applyFFlag("DFFlagTextureQualityOverrideEnabled", "True")
        applyFFlag("DFIntTextureQualityOverride", 0)
    end

    if type(RunService.Set3dRenderingEnabled) == "function" then
        pcall(RunService.Set3dRenderingEnabled, RunService, not disable3DRendering)
    end

    if optimizePhysics then
        pcall(function()
            local ps = settings().Physics
            if ps then
                pcall(setPropSafe, ps, "AllowSleep", true)
                local throttleEnum = resolvePhysicsThrottleEnum(physicsThrottle)
                if throttleEnum then
                    pcall(setPropSafe, ps, "PhysicsEnvironmentalThrottle", throttleEnum)
                end
            end
        end)
        if INTERPOLATION_ENABLED then
            pcall(setPropSafe, Workspace, "InterpolationThrottling", INTERPOLATION_ENABLED)
        end
    end

    if optimizeNetwork then
        pcall(function()
            local ns = settings().Network
            if ns then
                pcall(setPropSafe, ns, "IncomingReplicationLag", 0)
            end
        end)
        applyFFlag("FFlagOptimizeNetworkTransport", "True")
        applyFFlag("DFIntConnectionMTUSize", 1400)
    end

    if muteSounds then
        pcall(function()
            local gs = UserSettings():GetService("UserGameSettings")
            if gs then
                pcall(setPropSafe, gs, "MasterVolume", 0)
            end
        end)
    end

    if fpsCap then
        local capNum = tonumber(fpsCap)
        if capNum and capNum > 0 then
            if setFpsCap then
                pcall(setFpsCap, capNum)
            end
            applyFFlag("DFIntTaskSchedulerTargetFps", math.floor(capNum))
        elseif fpsCap == true then
            if setFpsCap then
                pcall(setFpsCap, 999)
            end
            applyFFlag("DFIntTaskSchedulerTargetFps", 999)
        end
    end

    local function getTerrainSafe()
        local okProp, propVal = pcall(function()
            return Workspace.Terrain
        end)
        if okProp and propVal then
            return propVal
        end
        local okFind, found = pcall(Workspace.FindFirstChildOfClass, Workspace, "Terrain")
        if okFind then
            return found
        end
        return nil
    end

    local terrain = getTerrainSafe()
    if terrain then
        applyTerrainSettings(terrain)
    elseif type(Workspace.GetPropertyChangedSignal) == "function" then
        local ok, sig = pcall(Workspace.GetPropertyChangedSignal, Workspace, "Terrain")
        if ok and sig then
            local terrainConn
            terrainConn = trackConnection(sig:Connect(function()
                local t = getTerrainSafe()
                if t then
                    applyTerrainSettings(t)
                    disconnectConn(terrainConn)
                end
            end))
        end
    end
end

-- Dynamic optimization queue with strict per-frame time budget
local INITIAL_FRAME_BUDGET = 0.004 -- 4ms per frame during initial pass
local DYNAMIC_FRAME_BUDGET = 0.002 -- 2ms per frame during gameplay

local function isSkippableQuick(inst)
    return not inst or SKIP_CLASSES[inst.ClassName]
end

local function enqueueInstance(inst)
    if not isActive() or not inst then
        return
    end
    local ok, skip = pcall(isSkippableQuick, inst)
    if not ok or skip then
        return
    end
    if not pendingSet[inst] then
        pendingSet[inst] = true
        queueTail = queueTail + 1
        pendingQueue[queueTail] = inst
    end
end

if dynamicOptimize then
    trackConnection(Workspace.DescendantAdded:Connect(enqueueInstance))
    trackConnection(Lighting.DescendantAdded:Connect(enqueueInstance))

    if type(Workspace.GetPropertyChangedSignal) == "function" then
        local ok, sig = pcall(Workspace.GetPropertyChangedSignal, Workspace, "CurrentCamera")
        if ok and sig then
            trackConnection(sig:Connect(function()
                local cam = Workspace.CurrentCamera
                if cam then
                    local okDesc, camDescendants = pcall(cam.GetDescendants, cam)
                    if okDesc and type(camDescendants) == "table" then
                        for i = 1, #camDescendants do
                            enqueueInstance(camDescendants[i])
                        end
                    end
                end
            end))
        end
    end

    trackConnection(RunService.Heartbeat:Connect(function()
        if not isActive() or queueHead > queueTail then
            return
        end
        local sliceStart = os.clock()
        local processed = 0
        while queueHead <= queueTail do
            local inst = pendingQueue[queueHead]
            pendingQueue[queueHead] = nil
            queueHead = queueHead + 1
            if inst then
                pendingSet[inst] = nil
                optimizeInstance(inst)
            end
            processed = processed + 1
            if processed % 64 == 0 and (os.clock() - sliceStart) >= DYNAMIC_FRAME_BUDGET then
                break
            end
        end
        if queueHead > queueTail then
            queueHead = 1
            queueTail = 0
        end
    end))
end

applyGlobalSettings()

local function scanContainer(container, budget)
    local okDesc, descendants = pcall(container.GetDescendants, container)
    if not okDesc or type(descendants) ~= "table" then
        return 0, 0, 0
    end
    local total = #descendants
    local optimized = 0
    local workTime = 0
    local sliceStart = os.clock()

    for i = 1, total do
        if not isActive() then
            return total, optimized, workTime
        end
        local inst = descendants[i]
        if inst and optimizeInstance(inst) then
            optimized = optimized + 1
        end
        if i % 256 == 0 then
            local now = os.clock()
            local elapsed = now - sliceStart
            if elapsed >= budget then
                workTime = workTime + elapsed
                waitTask()
                if not isActive() then
                    return total, optimized, workTime
                end
                sliceStart = os.clock()
            end
        end
    end

    workTime = workTime + (os.clock() - sliceStart)
    return total, optimized, workTime
end

-- Apply top-level Lighting & CurrentCamera immediately so visual effects disappear on frame 1
local okLightChildren, lightingChildren = pcall(Lighting.GetChildren, Lighting)
if okLightChildren and type(lightingChildren) == "table" then
    for i = 1, #lightingChildren do
        optimizeInstance(lightingChildren[i])
    end
end
if Workspace.CurrentCamera then
    local okCamDesc, camDescendants = pcall(Workspace.CurrentCamera.GetDescendants, Workspace.CurrentCamera)
    if okCamDesc and type(camDescendants) == "table" then
        for i = 1, #camDescendants do
            optimizeInstance(camDescendants[i])
        end
    end
end

if isActive() then
    print("[Optimizer] Optimizer script loaded")
end

-- Scan full Lighting & Workspace across frames without freezing the client
scanThread = spawnTask(function()
    if not isActive() then
        return
    end
    local lTotal, lOpt, lWork = scanContainer(Lighting, INITIAL_FRAME_BUDGET)
    if not isActive() then
        return
    end
    local wTotal, wOpt, wWork = scanContainer(Workspace, INITIAL_FRAME_BUDGET)
    if isActive() then
        scanThread = nil
        print(string.format(
            "Optimizer script successfully loaded! (%d/%d instances optimized in %.2fms CPU)",
            lOpt + wOpt,
            lTotal + wTotal,
            (lWork + wWork) * 1000
        ))
    end
end)
