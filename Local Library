        placeholdercolor = Color3.fromRGB(255, 255, 255),
        titlestrokecolor = Color3.fromRGB(0, 0, 0),
    }

    local globalInputConn = nil

    local function isReallyPressed(bind, inp)
        if not bind or not inp then
            return false
        end
        if (inp.KeyCode ~= nil and bind == inp.KeyCode) or (inp.UserInputType ~= nil and bind == inp.UserInputType) then
            return true
        end
        local bType = valueType(bind)
        if bType == "Instance" or bType == "InputObject" or bType == "table" then
            local okKbd, isKeyboard = pcall(function()
                return bind.UserInputType == Enum.UserInputType.Keyboard
            end)
            if okKbd and isKeyboard then
                return inp.KeyCode == bind.KeyCode
            end
            local okType, uType = pcall(function()
                return bind.UserInputType
            end)
            if okType and uType ~= nil and inp.UserInputType == uType then
                local okName, typeName = pcall(function()
                    return uType.Name
                end)
                return tostring(uType):find("MouseButton") ~= nil
                    or (okName and typeName and tostring(typeName):find("MouseButton") ~= nil)
            end
        end
        return false
    end

    local function ensureGlobalListeners()
        if globalInputConn or not UserInputService then
            return
        end
        local hidePos = UDim2.new(-1, 0, -0.5, 0)
        globalInputConn = connectSignal(UserInputService.InputBegan, function(input, gpe)
            if destroyed or gpe or not input then
                return
            end
            if input.KeyCode == Enum.KeyCode.RightControl then
                library.toggled = not library.toggled
                syncRainbowConnection()
                local dir = library.toggled and Enum.EasingDirection.Out or Enum.EasingDirection.In
                for _, data in next, library.queue do
                    if isObjectAlive(data.w) then
                        local pos = library.toggled and data.p or hidePos
                        tweenObject(data.w, 0.15, Enum.EasingStyle.Quad, dir, { Position = pos })
                    end
                end
            end
            if not library.binding then
                for idx, binds in next, library.binds do
                    local realBinding = binds.location[idx]
                    if realBinding and isReallyPressed(realBinding, input) then
                        binds.callback()
                    end
                end
            end
        end)
    end

    function library:Destroy()
        if destroyed then
            return
        end
        destroyed = true
        library.binding = false
        globalInputConn = nil
        stopRainbowLoop()

        local pendingCleanups = {}
        for fn in next, activeCleanups do
            pendingCleanups[#pendingCleanups + 1] = fn
        end
        for i = 1, #pendingCleanups do
            pcall(pendingCleanups[i])
        end
        activeCleanups = {}

        for i = #trackedConnections, 1, -1 do
            disconnectConn(trackedConnections[i])
            trackedConnections[i] = nil
        end

        for obj, tween in next, activeTweens do
            activeTweens[obj] = nil
            pcall(function()
                tween:Cancel()
            end)
        end

        if rootGui then
            local guiToDestroy = rootGui
            rootGui = nil
            pcall(guiToDestroy.Destroy, guiToDestroy)
        end

        library.count = 0
        library.toggled = true
        library.container = nil
        library.queue = {}
        library.callbacks = {}
        library.binds = {}
        library.rainbowtable = {}
    end
    library.Cleanup = library.Destroy

    function library:CreateWindow(name, options)
        destroyed = false
        ensureGlobalListeners()

        if not library.container then
            local containerFrame = self:Create("Frame", {
                Name = "Container",
                Size = UDim2.new(1, -30, 1, 0),
                Position = UDim2.new(0, 20, 0, 20),
                BackgroundTransparency = 1,
                Active = false,
            })

            rootGui = self:Create("ScreenGui", {
                Name = "LocalLibraryUI",
                ResetOnSpawn = false,
                containerFrame,
            })
            attachRootGui(rootGui)

            library.container = containerFrame
        end

        if not library.options then
            library.options = setmetatable(options or {}, { __index = default })
        elseif type(options) == "table" and options ~= library.options then
            local fallback = library.options
            if not getmetatable(options) then
                setmetatable(options, { __index = fallback })
            end
            library.options = options
        end

        local window, queueEntry = types.window(name, library.options)
        dragger.new(window.object, queueEntry)
        return window
    end

    library.options = setmetatable({}, { __index = default })
end

return library
