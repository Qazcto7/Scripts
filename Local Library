local library = {
    count = 0,
    queue = {},
    callbacks = {},
    rainbowtable = {},
    toggled = true,
    binds = {},
}

local default
do
    local valueType = typeof or type
    local CHECKMARK = utf8 and utf8.char(10003) or "v"

    local spawnTask = (task and task.spawn) or spawn
    local waitTask = (task and task.wait) or wait
    local delayTask = (task and task.delay) or function(seconds, fn)
        spawnTask(function()
            waitTask(seconds)
            fn()
        end)
    end

    local function safeGetService(serviceName)
        if not game or type(game.GetService) ~= "function" then
            return nil
        end
        local ok, service = pcall(game.GetService, game, serviceName)
        if ok then
            return service
        end
        return nil
    end

    local Players = safeGetService("Players")
    local UserInputService = safeGetService("UserInputService")
    local RunService = safeGetService("RunService")
    local TweenService = safeGetService("TweenService")
    local GuiService = safeGetService("GuiService")
    local CoreGui = safeGetService("CoreGui")

    local trackedConnections = {}
    local activeCleanups = {}
    local activeTweens = setmetatable({}, { __mode = "k" })
    local tweenInfoCache = {}
    local rootGui = nil
    local destroyed = false
    local rainbowConn = nil
    local rainbowHue = 0
    local rainbowElapsed = 0

    local function trackConnection(conn)
        if conn then
            table.insert(trackedConnections, conn)
        end
        return conn
    end

    local function disconnectConn(conn)
        if not conn then
            return
        end
        pcall(function()
            if type(conn.Disconnect) == "function" then
                conn:Disconnect()
            elseif type(conn.disconnect) == "function" then
                conn:disconnect()
            end
        end)
    end

    local function connectSignal(signal, callback, untracked)
        if not signal then
            return nil
        end
        local ok, conn = pcall(function()
            return signal:Connect(callback)
        end)
        if not ok then
            ok, conn = pcall(function()
                return signal:connect(callback)
            end)
        end
        if not ok then
            return nil
        end
        if not untracked then
            trackConnection(conn)
        end
        return conn
    end

    local function getGuiInset()
        if GuiService and type(GuiService.GetGuiInset) == "function" then
            local ok, inset = pcall(GuiService.GetGuiInset, GuiService)
            if ok and inset then
                return inset
            end
        end
        return Vector2.new(0, 36)
    end

    local function getMousePos()
        if UserInputService and type(UserInputService.GetMouseLocation) == "function" then
            local ok, pos = pcall(UserInputService.GetMouseLocation, UserInputService)
            if ok and pos then
                return pos
            end
        end
        return Vector2.new(0, 0)
    end

    local function tryParentGui(gui, parent)
        if not parent then
            return false
        end
        local ok = pcall(function()
            gui.Parent = parent
        end)
        return ok and gui.Parent == parent
    end

    local function attachRootGui(gui)
        local coreGuiContainer = CoreGui or safeGetService("CoreGui")
        if tryParentGui(gui, coreGuiContainer) then
            return true
        end
        local localPlayer = Players and Players.LocalPlayer
        if localPlayer then
            if type(localPlayer.FindFirstChildOfClass) == "function" then
                local pg = localPlayer:FindFirstChildOfClass("PlayerGui")
                if tryParentGui(gui, pg) then
                    return true
                end
            end
            if type(localPlayer.WaitForChild) == "function" then
                local ok, pg = pcall(localPlayer.WaitForChild, localPlayer, "PlayerGui", 5)
                if ok and tryParentGui(gui, pg) then
                    return true
                end
            end
        end
        if type(gethui) == "function" then
            local ok, hui = pcall(gethui)
            if ok and tryParentGui(gui, hui) then
                return true
            end
        end
        return false
    end

    local function getTweenInfo(duration, style, direction)
        local key = tostring(duration) .. "|" .. tostring(style) .. "|" .. tostring(direction)
        local cached = tweenInfoCache[key]
        if cached then
            return cached
        end
        if TweenInfo and type(TweenInfo.new) == "function" then
            cached = TweenInfo.new(duration, style, direction)
            tweenInfoCache[key] = cached
            return cached
        end
        return nil
    end

    local function cancelTween(obj)
        local prev = activeTweens[obj]
        if prev then
            activeTweens[obj] = nil
            pcall(function()
                prev:Cancel()
            end)
        end
    end

    local function tweenObject(obj, duration, style, direction, props, onComplete)
        if not obj then
            return nil
        end
        cancelTween(obj)

        local info = TweenService and type(TweenService.Create) == "function" and getTweenInfo(duration, style, direction)
        if info then
            local tween = TweenService:Create(obj, info, props)
            activeTweens[obj] = tween
            if tween.Completed then
                local completedConn
                completedConn = connectSignal(tween.Completed, function()
                    disconnectConn(completedConn)
                    if activeTweens[obj] == tween then
                        activeTweens[obj] = nil
                    end
                    if onComplete then
                        onComplete()
                    end
                end, true)
            elseif onComplete then
                delayTask(duration, onComplete)
            end
            tween:Play()
            return tween
        end

        -- Fallback for mocks or stripped environments lacking TweenService
        local dirName = (direction and direction.Name) or "Out"
        local styleName = (style and style.Name) or "Quint"
        if props.Size and type(obj.TweenSize) == "function" then
            pcall(obj.TweenSize, obj, props.Size, dirName, styleName, duration, true)
        end
        if props.Position and type(obj.TweenPosition) == "function" then
            pcall(obj.TweenPosition, obj, props.Position, dirName, styleName, duration, true)
        end
        if onComplete then
            delayTask(duration, onComplete)
        end
        return nil
    end

    local function isObjectAlive(obj)
        if not obj then
            return false
        end
        if valueType(obj) == "Instance" then
            return obj.Parent ~= nil
        end
        return true
    end

    local function stopRainbowLoop()
        if rainbowConn then
            disconnectConn(rainbowConn)
            rainbowConn = nil
        end
    end

    -- Event-driven rainbow animation: 0 CPU when disabled, hidden, or empty
    local function syncRainbowConnection()
        if destroyed or (not library.toggled) or #library.rainbowtable == 0 then
            stopRainbowLoop()
            return
        end
        if rainbowConn or not (RunService and RunService.Heartbeat) then
            return
        end

        rainbowElapsed = 0
        rainbowConn = connectSignal(RunService.Heartbeat, function(dt)
            if destroyed or (not library.toggled) then
                stopRainbowLoop()
                return
            end

            rainbowElapsed = rainbowElapsed + (tonumber(dt) or (1 / 60))
            if rainbowElapsed < (1 / 30) then
                return
            end
            local stepDt = rainbowElapsed
            rainbowElapsed = 0

            rainbowHue = (rainbowHue + stepDt * 0.1) % 1
            local color = Color3.fromHSV(rainbowHue, 1, 1)

            local count = #library.rainbowtable
            local writeIdx = 0
            for readIdx = 1, count do
                local obj = library.rainbowtable[readIdx]
                if isObjectAlive(obj) then
                    writeIdx = writeIdx + 1
                    library.rainbowtable[writeIdx] = obj
                    pcall(function()
                        obj.BackgroundColor3 = color
                    end)
                end
            end
            for clearIdx = writeIdx + 1, count do
                library.rainbowtable[clearIdx] = nil
            end

            if writeIdx == 0 then
                stopRainbowLoop()
            end
        end, true)
    end

    local dragger = {}
    do
        -- Event-driven dragger (inspired by Ririchi / Inori dragger, zero Heartbeat polling)
        function dragger.new(frame, queueEntry)
            if not frame then
                return
            end
            local okActive = pcall(function()
                frame.Active = true
            end)
            if not okActive then
                return
            end

            local dragging = false
            local dragInputType = nil
            local dragStart = nil
            local startPos = nil
            local moveConn = nil
            local endConn = nil

            local function stopDrag()
                dragging = false
                dragInputType = nil
                activeCleanups[stopDrag] = nil
                disconnectConn(moveConn)
                disconnectConn(endConn)
                moveConn = nil
                endConn = nil
                if not destroyed and queueEntry and library.toggled then
                    queueEntry.p = frame.Position
                end
            end

            connectSignal(frame.InputBegan, function(input)
                if destroyed or dragging or not input then
                    return
                end
                local uType = input.UserInputType
                if uType ~= Enum.UserInputType.MouseButton1 and uType ~= Enum.UserInputType.Touch then
                    return
                end

                cancelTween(frame)
                dragging = true
                dragInputType = uType
                dragStart = input.Position or getMousePos()
                startPos = frame.Position
                activeCleanups[stopDrag] = true

                if UserInputService then
                    moveConn = connectSignal(UserInputService.InputChanged, function(changedInput)
                        if not dragging or destroyed or not changedInput then
                            if destroyed then
                                stopDrag()
                            end
                            return
                        end
                        if changedInput.UserInputType == Enum.UserInputType.MouseMovement
                            or changedInput.UserInputType == Enum.UserInputType.Touch then
                            local pos = changedInput.Position or getMousePos()
                            local delta = pos - dragStart
                            frame.Position = UDim2.new(
                                startPos.X.Scale,
                                startPos.X.Offset + delta.X,
                                startPos.Y.Scale,
                                startPos.Y.Offset + delta.Y
                            )
                        end
                    end, true)

                    endConn = connectSignal(UserInputService.InputEnded, function(endedInput)
                        if destroyed then
                            stopDrag()
                            return
                        end
                        if endedInput and (endedInput.UserInputType == dragInputType or endedInput.UserInputType == Enum.UserInputType.MouseButton1) then
                            stopDrag()
                        end
                    end, true)
                end
            end)
        end
    end

    local types = {}
    do
        types.__index = types

        function types.window(name, options)
            library.count = library.count + 1

            local listLayout = library:Create("UIListLayout", {
                Name = "List",
                SortOrder = Enum.SortOrder.LayoutOrder,
            })

            local containerFrame = library:Create("Frame", {
                Name = "container",
                Position = UDim2.new(0, 0, 1, 0),
                Size = UDim2.new(1, 0, 0, 0),
                BorderSizePixel = 0,
                BackgroundColor3 = options.bgcolor,
                ClipsDescendants = false,
                listLayout,
            })

            local toggleBtn = library:Create("TextButton", {
                Size = UDim2.new(0, 30, 0, 30),
                Position = UDim2.new(1, -35, 0, 0),
                BackgroundTransparency = 1,
                Text = "-",
                TextSize = options.titlesize,
                Font = options.titlefont, -- Enum.Font.Code;
                Name = "window_toggle",
                TextColor3 = options.titletextcolor,
                TextStrokeTransparency = options.titlestroke,
                TextStrokeColor3 = options.titlestrokecolor,
                ZIndex = 3,
            })

            local underline = library:Create("Frame", {
                Name = "Underline",
                Size = UDim2.new(1, 0, 0, 2),
                Position = UDim2.new(0, 0, 1, -2),
                BackgroundColor3 = (options.underlinecolor ~= "rainbow" and options.underlinecolor or Color3.new()),
                BorderSizePixel = 0,
                ZIndex = 3,
            })

            local newWindow = library:Create("Frame", {
                Name = name,
                Size = UDim2.new(0, 190, 0, 30),
                BackgroundColor3 = options.topcolor,
                BorderSizePixel = 0,
                Parent = library.container,
                Position = UDim2.new(0, (15 + (200 * library.count) - 200), 0, 0),
                ZIndex = 3,
                library:Create("TextLabel", {
                    Text = name,
                    Size = UDim2.new(1, -10, 1, 0),
                    Position = UDim2.new(0, 5, 0, 0),
                    BackgroundTransparency = 1,
                    TextSize = options.titlesize,
                    Font = options.titlefont,
                    TextColor3 = options.titletextcolor,
                    TextStrokeTransparency = options.titlestroke,
                    TextStrokeColor3 = options.titlestrokecolor,
                    ZIndex = 3,
                }),
                toggleBtn,
                underline,
                containerFrame,
            })

            if options.underlinecolor == "rainbow" then
                table.insert(library.rainbowtable, underline)
                syncRainbowConnection()
            end

            local window = setmetatable({
                count = 0,
                object = newWindow,
                container = containerFrame,
                listLayout = listLayout,
                toggled = true,
                flags = {},
            }, types)

            local queueEntry = {
                w = window.object,
                p = window.object.Position,
            }
            table.insert(library.queue, queueEntry)

            local toggleSerial = 0
            connectSignal(toggleBtn.MouseButton1Click, function()
                toggleSerial = toggleSerial + 1
                local currentSerial = toggleSerial
                window.toggled = not window.toggled
                toggleBtn.Text = window.toggled and "-" or "+"
                if not window.toggled then
                    containerFrame.ClipsDescendants = true
                end

                local y = window:GetContentHeight()
                local targetSize = window.toggled and UDim2.new(1, 0, 0, y + 5) or UDim2.new(1, 0, 0, 0)
                local targetDirection = window.toggled and Enum.EasingDirection.In or Enum.EasingDirection.Out

                tweenObject(containerFrame, 0.3, Enum.EasingStyle.Quint, targetDirection, { Size = targetSize }, function()
                    if window.toggled and currentSerial == toggleSerial and isObjectAlive(containerFrame) then
                        containerFrame.ClipsDescendants = false
                    end
                end)
            end)

            return window, queueEntry
        end

        function types:GetContentHeight()
            local layout = self.listLayout
            if layout and layout.AbsoluteContentSize and layout.AbsoluteContentSize.Y > 0 then
                return layout.AbsoluteContentSize.Y
            end
            local y = 0
            for _, v in next, self.container:GetChildren() do
                if not v:IsA("UIListLayout") and v.Visible ~= false then
                    local childY = (v.AbsoluteSize and v.AbsoluteSize.Y) or 0
                    if childY <= 0 and v.Size and v.Size.Y then
                        childY = v.Size.Y.Offset
                    end
                    y = y + childY
                end
            end
            return y
        end

        function types:Resize()
            if not self.toggled then
                return
            end
            self.container.Size = UDim2.new(1, 0, 0, self:GetContentHeight() + 5)
        end

        function types:GetOrder()
            return self.count
        end

        local function createLabeledRow(container, name, order, control, rowHeight, labelPosY, extraLabelProps)
            local labelProps = {
                Name = name,
                Text = "\r" .. name,
                BackgroundTransparency = 1,
                TextColor3 = library.options.textcolor,
                Position = UDim2.new(0, 5, 0, labelPosY or 0),
                Size = UDim2.new(1, -5, 1, 0),
                TextXAlignment = Enum.TextXAlignment.Left,
                Font = library.options.font,
                TextSize = library.options.fontsize,
                TextStrokeTransparency = library.options.textstroke,
                TextStrokeColor3 = library.options.strokecolor,
                control,
            }
            if extraLabelProps then
                for k, v in next, extraLabelProps do
                    labelProps[k] = v
                end
            end
            return library:Create("Frame", {
                BackgroundTransparency = 1,
                Size = UDim2.new(1, 0, 0, rowHeight or 25),
                LayoutOrder = order,
                library:Create("TextLabel", labelProps),
                Parent = container,
            })
        end

        function types:Toggle(name, options, callback)
            options = options or {}
            local defaultVal = options.default or false
            local location = options.location or self.flags
            local flag = options.flag or ""
            callback = callback or function() end

            location[flag] = defaultVal
            local order = self.count
            self.count = order + 1

            local checkmark = library:Create("TextButton", {
                Text = location[flag] and CHECKMARK or "",
                Font = library.options.font,
                TextSize = library.options.fontsize,
                Name = "Checkmark",
                Size = UDim2.new(0, 20, 0, 20),
                Position = UDim2.new(1, -25, 0, 4),
                TextColor3 = library.options.textcolor,
                BackgroundColor3 = library.options.bgcolor,
                BorderColor3 = library.options.bordercolor,
                TextStrokeTransparency = library.options.textstroke,
                TextStrokeColor3 = library.options.strokecolor,
            })

            createLabeledRow(self.container, name, order, checkmark, 25, 0)

            local function click()
                location[flag] = not location[flag]
                callback(location[flag])
                checkmark.Text = location[flag] and CHECKMARK or ""
            end

            connectSignal(checkmark.MouseButton1Click, click)
            library.callbacks[flag] = click

            if location[flag] == true then
                callback(location[flag])
            end

            self:Resize()
            return {
                Set = function(_, b)
                    location[flag] = b
                    callback(location[flag])
                    checkmark.Text = location[flag] and CHECKMARK or ""
                end,
            }
        end

        function types:Button(name, callback)
            callback = callback or function() end
            local order = self.count
            self.count = order + 1

            local btn = library:Create("TextButton", {
                Name = name,
                Text = name,
                BackgroundColor3 = library.options.btncolor,
                BorderColor3 = library.options.bordercolor,
                TextStrokeTransparency = library.options.textstroke,
                TextStrokeColor3 = library.options.strokecolor,
                TextColor3 = library.options.textcolor,
                Position = UDim2.new(0, 5, 0, 5),
                Size = UDim2.new(1, -10, 0, 20),
                Font = library.options.font,
                TextSize = library.options.fontsize,
            })

            library:Create("Frame", {
                BackgroundTransparency = 1,
                Size = UDim2.new(1, 0, 0, 25),
                LayoutOrder = order,
                btn,
                Parent = self.container,
            })

            connectSignal(btn.MouseButton1Click, callback)
            self:Resize()

            return {
                Fire = function()
                    callback()
                end,
            }
        end

        function types:Box(name, options, callback)
            options = options or {}
            local boxType = options.type or ""
            local defaultVal = options.default or ""
            local location = options.location or self.flags
            local flag = options.flag or ""
            callback = callback or function() end
            local min = options.min or 0
            local max = options.max or 9e9

            if boxType == "number" then
                local numDefault = tonumber(defaultVal)
                if numDefault then
                    defaultVal = math.clamp(numDefault, min, max)
                    location[flag] = defaultVal
                else
                    defaultVal = ""
                    location[flag] = ""
                end
            else
                defaultVal = tostring(defaultVal)
                location[flag] = defaultVal
            end

            local order = self.count
            self.count = order + 1

            local box = library:Create("TextBox", {
                TextStrokeTransparency = library.options.textstroke,
                TextStrokeColor3 = library.options.strokecolor,
                Text = tostring(defaultVal),
                Font = library.options.font,
                TextSize = library.options.fontsize,
                Name = "Box",
                Size = UDim2.new(0, 60, 0, 20),
                Position = UDim2.new(1, -65, 0, 3),
                TextColor3 = library.options.textcolor,
                BackgroundColor3 = library.options.boxcolor,
                BorderColor3 = library.options.bordercolor,
                PlaceholderColor3 = library.options.placeholdercolor,
            })

            createLabeledRow(self.container, name, order, box, 25, 0)

            connectSignal(box.FocusLost, function(enterPressed)
                local old = location[flag]
                if boxType == "number" then
                    local num = tonumber(box.Text)
                    if not num then
                        box.Text = tostring(location[flag] or "")
                    else
                        local clamped = math.clamp(num, min, max)
                        location[flag] = clamped
                        box.Text = tostring(clamped)
                    end
                else
                    location[flag] = tostring(box.Text)
                end

                callback(location[flag], old, enterPressed)
            end)

            if boxType == "number" and type(box.GetPropertyChangedSignal) == "function" then
                connectSignal(box:GetPropertyChangedSignal("Text"), function()
                    local current = box.Text
                    local cleaned = string.gsub(current, "[^%d%.%-]", "")
                    if cleaned ~= current then
                        box.Text = cleaned
                    end
                end)
            end

            self:Resize()
            return box
        end

        local BANNED_BINDS = {
            Return = true,
            Space = true,
            Tab = true,
            Unknown = true,
        }

        local SHORT_BIND_NAMES = {
            RightControl = "RightCtrl",
            LeftControl = "LeftCtrl",
            LeftShift = "LShift",
            RightShift = "RShift",
            MouseButton1 = "Mouse1",
            MouseButton2 = "Mouse2",
        }

        local ALLOWED_MOUSE_BINDS = {
            MouseButton1 = true,
            MouseButton2 = true,
        }

        local function formatBindName(bindObj)
            if not bindObj then
                return "None"
            end
            local rawName
            local okInput = pcall(function()
                if bindObj.UserInputType and Enum and Enum.UserInputType and bindObj.UserInputType ~= Enum.UserInputType.Keyboard then
                    rawName = bindObj.UserInputType.Name
                elseif bindObj.KeyCode then
                    rawName = bindObj.KeyCode.Name
                end
            end)
            if not okInput or not rawName then
                local okName, directName = pcall(function()
                    return bindObj.Name
                end)
                rawName = (okName and directName) or tostring(bindObj)
            end
            return SHORT_BIND_NAMES[rawName] or rawName
        end

        function types:Bind(name, options, callback)
            options = options or {}
            local location = options.location or self.flags
            local keyboardOnly = options.kbonly or false
            local flag = options.flag or ""
            callback = callback or function() end
            local defaultBind = options.default

            local isMouseDefault = false
            if defaultBind ~= nil then
                local okName, defName = pcall(function()
                    return defaultBind.Name
                end)
                isMouseDefault = tostring(defaultBind):find("MouseButton") ~= nil
                    or (okName and defName and tostring(defName):find("MouseButton") ~= nil)
            end
            if defaultBind ~= nil and ((not keyboardOnly) or (not isMouseDefault)) then
                location[flag] = defaultBind
            end

            local order = self.count
            self.count = order + 1

            local initialLabel = location[flag] and formatBindName(location[flag]) or "None"

            local button = library:Create("TextButton", {
                Name = "Keybind",
                Text = initialLabel,
                TextStrokeTransparency = library.options.textstroke,
                TextStrokeColor3 = library.options.strokecolor,
                Font = library.options.font,
                TextSize = library.options.fontsize,
                Size = UDim2.new(0, 60, 0, 20),
                Position = UDim2.new(1, -65, 0, 5),
                TextColor3 = library.options.textcolor,
                BackgroundColor3 = library.options.bgcolor,
                BorderColor3 = library.options.bordercolor,
                BorderSizePixel = 1,
            })

            createLabeledRow(self.container, name, order, button, 30, 0, {
                BorderColor3 = library.options.bordercolor,
                BorderSizePixel = 1,
            })

            connectSignal(button.MouseButton1Click, function()
                if library.binding or destroyed or not UserInputService then
                    return
                end
                library.binding = true
                button.Text = "..."

                local onceConn
                onceConn = connectSignal(UserInputService.InputBegan, function(inputObj)
                    disconnectConn(onceConn)
                    onceConn = nil

                    local ok = pcall(function()
                        if not inputObj then
                            return
                        end
                        local keyCodeName = inputObj.KeyCode and tostring(inputObj.KeyCode.Name) or "Unknown"
                        local userTypeName = inputObj.UserInputType and tostring(inputObj.UserInputType.Name) or ""
                        local isMouseAllowed = (inputObj.UserInputType ~= Enum.UserInputType.Keyboard)
                            and ALLOWED_MOUSE_BINDS[userTypeName]
                            and (not keyboardOnly)
                        local isKeyAllowed = (inputObj.UserInputType == Enum.UserInputType.Keyboard or not inputObj.UserInputType)
                            and inputObj.KeyCode
                            and (not BANNED_BINDS[keyCodeName])

                        if isMouseAllowed or isKeyAllowed then
                            location[flag] = inputObj
                            button.Text = formatBindName(inputObj)
                        elseif location[flag] then
                            button.Text = formatBindName(location[flag])
                        else
                            button.Text = "None"
                        end
                    end)

                    if not ok then
                        button.Text = location[flag] and formatBindName(location[flag]) or "None"
                    end
                    delayTask(0.1, function()
                        library.binding = false
                    end)
                end)
            end)

            library.binds[flag] = {
                location = location,
                callback = callback,
            }

            self:Resize()
        end

        function types:Section(name)
            local order = self.count
            self.count = order + 1

            local determinedSize = UDim2.new(1, 0, 0, 25)
            local determinedPos = UDim2.new(0, 0, 0, 4)
            local secondarySize = UDim2.new(1, 0, 0, 20)

            if order == 0 then
                determinedSize = UDim2.new(1, 0, 0, 21)
                determinedPos = UDim2.new(0, 0, 0, -1)
                secondarySize = UDim2.new(1, 0, 1, 0)
            end

            library:Create("Frame", {
                Name = "Section",
                BackgroundTransparency = 1,
                Size = determinedSize,
                BackgroundColor3 = library.options.sectncolor,
                BorderSizePixel = 0,
                LayoutOrder = order,
                library:Create("TextLabel", {
                    Name = "section_lbl",
                    Text = name,
                    BackgroundTransparency = 0,
                    BorderSizePixel = 0,
                    BackgroundColor3 = library.options.sectncolor,
                    TextColor3 = library.options.textcolor,
