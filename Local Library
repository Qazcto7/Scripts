        function types:Slider(name, options, callback)
            options = options or {}
            local min = options.min or 0
            local max = options.max or 1
            local defaultVal = options.default ~= nil and options.default or min
            local location = options.location or self.flags
            local precise = options.precise or false -- e.g 0, 1 vs 0, 0.1, 0.2, ...
            local flag = options.flag or ""
            callback = callback or function() end

            local span = max - min
            local function formatSliderValue(num)
                if precise then
                    return tonumber(string.format("%.2f", num))
                end
                return math.floor(num + 1e-9)
            end

            local initialNumber = formatSliderValue(math.clamp(defaultVal, min, max))
            location[flag] = defaultVal

            local order = self.count
            self.count = order + 1

            local valueLabel = library:Create("TextLabel", {
                Name = "ValueLabel",
                Text = tostring(defaultVal),
                BackgroundTransparency = 1,
                TextColor3 = library.options.textcolor,
                Position = UDim2.new(0, -10, 0, 0),
                Size = UDim2.new(0, 1, 1, 0),
                TextXAlignment = Enum.TextXAlignment.Right,
                Font = library.options.font,
                TextSize = library.options.fontsize,
                TextStrokeTransparency = library.options.textstroke,
                TextStrokeColor3 = library.options.strokecolor,
            })

            local knobButton = library:Create("TextButton", {
                Name = "Button",
                Size = UDim2.new(0, 5, 1, -2),
                Position = UDim2.new(0, 0, 0, 1),
                AutoButtonColor = false,
                Text = "",
                BackgroundColor3 = Color3.fromRGB(20, 20, 20),
                BorderSizePixel = 0,
                ZIndex = 2,
                TextStrokeTransparency = library.options.textstroke,
                TextStrokeColor3 = library.options.strokecolor,
            })

            local sliderContainer = library:Create("Frame", {
                Name = "Container",
                Size = UDim2.new(0, 60, 0, 20),
                Position = UDim2.new(1, -65, 0, 3),
                BackgroundTransparency = 1,
                BorderSizePixel = 0,
                valueLabel,
                knobButton,
                library:Create("Frame", {
                    Name = "Line",
                    BackgroundTransparency = 0,
                    Position = UDim2.new(0, 0, 0.5, 0),
                    Size = UDim2.new(1, 0, 0, 1),
                    BackgroundColor3 = library.options.textcolor,
                    BorderSizePixel = 0,
                }),
            })

            createLabeledRow(self.container, name, order, sliderContainer, 25, 2)

            local lastCallbackValue = defaultVal

            local function applyPercent(percent, fireCallback)
                percent = math.clamp(percent, 0, 1)
                percent = tonumber(string.format("%.2f", percent)) or 0
                knobButton.Position = UDim2.new(math.clamp(percent, 0, 0.99), 0, 0, 1)

                local value = formatSliderValue(min + span * percent)
                valueLabel.Text = tostring(value)
                location[flag] = value
                if fireCallback and value ~= lastCallbackValue then
                    lastCallbackValue = value
                    callback(value)
                end
            end

            if defaultVal ~= min then
                local initPercent = span ~= 0 and (1 - ((max - defaultVal) / span)) or 0
                knobButton.Position = UDim2.new(math.clamp(initPercent, 0, 0.99), 0, 0, 1)
                valueLabel.Text = tostring(initialNumber)
            end

            local dragging = false
            local moveConn = nil
            local endConn = nil

            local function updateFromX(mouseX)
                local width = sliderContainer.AbsoluteSize.X
                if width <= 0 then
                    return
                end
                local percent = (mouseX - sliderContainer.AbsolutePosition.X) / width
                applyPercent(percent, true)
            end

            local function stopSliderDrag()
                dragging = false
                activeCleanups[stopSliderDrag] = nil
                disconnectConn(moveConn)
                disconnectConn(endConn)
                moveConn = nil
                endConn = nil
            end

            local function startSliderDrag(initialX)
                if dragging or destroyed then
                    return
                end
                dragging = true
                activeCleanups[stopSliderDrag] = true
                updateFromX(initialX or getMousePos().X)

                if UserInputService then
                    moveConn = connectSignal(UserInputService.InputChanged, function(input)
                        if not dragging or destroyed or not input then
                            if destroyed then
                                stopSliderDrag()
                            end
                            return
                        end
                        if input.UserInputType == Enum.UserInputType.MouseMovement
                            or input.UserInputType == Enum.UserInputType.Touch then
                            local x = (input.Position and input.Position.X) or getMousePos().X
                            updateFromX(x)
                        end
                    end, true)

                    endConn = connectSignal(UserInputService.InputEnded, function(input)
                        if destroyed then
                            stopSliderDrag()
                            return
                        end
                        if input and (input.UserInputType == Enum.UserInputType.MouseButton1
                            or input.UserInputType == Enum.UserInputType.Touch) then
                            stopSliderDrag()
                        end
                    end, true)
                end
            end

            connectSignal(sliderContainer.InputBegan, function(input)
                if input and (input.UserInputType == Enum.UserInputType.MouseButton1
                    or input.UserInputType == Enum.UserInputType.Touch) then
                    startSliderDrag(input.Position and input.Position.X)
                end
            end)

            connectSignal(knobButton.MouseButton1Down, function()
                startSliderDrag(getMousePos().X)
            end)

            self:Resize()
            return {
                Set = function(_, value)
                    local clamped = math.clamp(value, min, max)
                    local percent = span ~= 0 and (1 - ((max - clamped) / span)) or 0
                    local number = formatSliderValue(clamped)
                    knobButton.Position = UDim2.new(math.clamp(percent, 0, 0.99), 0, 0, 1)
                    valueLabel.Text = tostring(number)
                    location[flag] = number
                    lastCallbackValue = number
                    callback(number)
                end,
            }
        end

        function types:SearchBox(text, options, callback)
            options = options or {}
            local list = options.list or {}
            local flag = options.flag or ""
            local location = options.location or self.flags
            callback = callback or function() end

            local order = self.count
            self.count = order + 1

            local container = library:Create("ScrollingFrame", {
                Position = UDim2.new(0, 0, 1, 1),
                Name = "Container",
                BackgroundColor3 = library.options.btncolor,
                ScrollBarThickness = 0,
                BorderSizePixel = 0,
                BorderColor3 = library.options.bordercolor,
                Size = UDim2.new(1, 0, 0, 0),
                library:Create("UIListLayout", {
                    Name = "ListLayout",
                    SortOrder = Enum.SortOrder.LayoutOrder,
                }),
                ZIndex = 2,
            })

            local searchBox = library:Create("TextBox", {
                Text = "",
                PlaceholderText = text,
                PlaceholderColor3 = Color3.fromRGB(60, 60, 60),
                Font = library.options.font,
                TextSize = library.options.fontsize,
                Name = "Box",
                Size = UDim2.new(1, -10, 0, 20),
                Position = UDim2.new(0, 5, 0, 4),
                TextColor3 = library.options.textcolor,
                BackgroundColor3 = library.options.dropcolor,
                BorderColor3 = library.options.bordercolor,
                TextStrokeTransparency = library.options.textstroke,
                TextStrokeColor3 = library.options.strokecolor,
                container,
            })

            library:Create("Frame", {
                BackgroundTransparency = 1,
                Size = UDim2.new(1, 0, 0, 25),
                LayoutOrder = order,
                searchBox,
                Parent = self.container,
            })

            local buttonPool = {}
            local lowerList = {}
            local suppressNextText = nil

            local function indexList(items)
                lowerList = {}
                for idx, val in next, items do
                    local str = tostring(val)
                    lowerList[#lowerList + 1] = {
                        raw = str,
                        lower = string.lower(str),
                        order = idx,
                    }
                end
            end
            indexList(list)

            local function clearVisibleOptions()
                for i = 1, #buttonPool do
                    buttonPool[i].button.Visible = false
                end
                container.ScrollBarThickness = 0
                container.CanvasSize = UDim2.new(1, 0, 0, 0)
                tweenObject(container, 0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.Out, {
                    Size = UDim2.new(1, 0, 0, 0),
                })
            end

            local function getPooledButton(index)
                local entry = buttonPool[index]
                if entry then
                    return entry
                end
                local btn = library:Create("TextButton", {
                    Text = "",
                    Font = library.options.font,
                    TextSize = library.options.fontsize,
                    TextColor3 = library.options.textcolor,
                    BorderColor3 = library.options.bordercolor,
                    TextStrokeTransparency = library.options.textstroke,
                    TextStrokeColor3 = library.options.strokecolor,
                    Parent = container,
                    Size = UDim2.new(1, 0, 0, 20),
                    LayoutOrder = index,
                    BackgroundColor3 = library.options.btncolor,
                    ZIndex = 2,
                })
                entry = { button = btn, value = "" }
                connectSignal(btn.MouseButton1Click, function()
                    local selected = entry.value
                    suppressNextText = selected
                    searchBox.Text = selected
                    location[flag] = selected
                    callback(selected)
                    clearVisibleOptions()
                end)
                buttonPool[index] = entry
                return entry
            end

            local function rebuild(queryText)
                local matchCount = 0
                local queryLen = #queryText
                if queryLen > 0 then
                    local lowerQuery = string.lower(queryText)
                    for i = 1, #lowerList do
                        local item = lowerList[i]
                        if string.sub(item.lower, 1, queryLen) == lowerQuery then
                            matchCount = matchCount + 1
                            local entry = getPooledButton(matchCount)
                            entry.value = item.raw
                            entry.button.Text = item.raw
                            entry.button.LayoutOrder = item.order
                            entry.button.Visible = true
                        end
                    end
                end

                for i = matchCount + 1, #buttonPool do
                    buttonPool[i].button.Visible = false
                end

                local totalHeight = 20 * matchCount
                local clampedHeight = math.clamp(totalHeight, 0, 100)
                container.ScrollBarThickness = totalHeight > 100 and 5 or 0
                container.CanvasSize = UDim2.new(1, 0, 0, totalHeight)
                tweenObject(container, 0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.Out, {
                    Size = UDim2.new(1, 0, 0, clampedHeight),
                })
            end

            if type(searchBox.GetPropertyChangedSignal) == "function" then
                connectSignal(searchBox:GetPropertyChangedSignal("Text"), function()
                    local current = searchBox.Text
                    if suppressNextText ~= nil and current == suppressNextText then
                        suppressNextText = nil
                        return
                    end
                    suppressNextText = nil
                    rebuild(current)
                end)
            end

            local function reload(newList)
                list = newList or {}
                indexList(list)
                rebuild("")
            end

            self:Resize()
            return reload, searchBox
        end

        function types:Dropdown(name, options, callback)
            options = options or {}
            local location = options.location or self.flags
            local flag = options.flag or ""
            callback = callback or function() end
            local list = options.list or {}

            location[flag] = list[1]
            local order = self.count
            self.count = order + 1

            local selectionLbl = library:Create("TextLabel", {
                Name = "Selection",
                Size = UDim2.new(1, 0, 1, 0),
                Text = list[1] ~= nil and tostring(list[1]) or "",
                TextColor3 = library.options.textcolor,
                BackgroundTransparency = 1,
                Font = library.options.font,
                TextSize = library.options.fontsize,
                TextStrokeTransparency = library.options.textstroke,
                TextStrokeColor3 = library.options.strokecolor,
            })

            local dropBtn = library:Create("TextButton", {
                Name = "drop",
                BackgroundTransparency = 1,
                Size = UDim2.new(0, 20, 1, 0),
                Position = UDim2.new(1, -25, 0, 0),
                Text = "v",
                TextColor3 = library.options.textcolor,
                Font = library.options.font,
                TextSize = library.options.fontsize,
                TextStrokeTransparency = library.options.textstroke,
                TextStrokeColor3 = library.options.strokecolor,
            })

            local dropdownLbl = library:Create("Frame", {
                Name = "dropdown_lbl",
                BackgroundTransparency = 0,
                BackgroundColor3 = library.options.dropcolor,
                Position = UDim2.new(0, 5, 0, 4),
                BorderColor3 = library.options.bordercolor,
                Size = UDim2.new(1, -10, 0, 20),
                selectionLbl,
                dropBtn,
            })

            library:Create("Frame", {
                BackgroundTransparency = 1,
                Size = UDim2.new(1, 0, 0, 25),
                BackgroundColor3 = Color3.fromRGB(25, 25, 25),
                BorderSizePixel = 0,
                LayoutOrder = order,
                dropdownLbl,
                Parent = self.container,
            })

            local activeContainer = nil
            local outsideConn = nil
            local dropdownToken = 0
            local closeDropdown

            local function cleanupOpenDropdown()
                closeDropdown(false)
            end

            local function isInGui(frame)
                local mloc = getMousePos()
                local inset = getGuiInset()
                local mouseX = mloc.X - inset.X
                local mouseY = mloc.Y - inset.Y
                local x1 = frame.AbsolutePosition.X
                local y1 = frame.AbsolutePosition.Y
                local x2 = x1 + frame.AbsoluteSize.X
                local y2 = y1 + frame.AbsoluteSize.Y
                return (mouseX >= x1 and mouseX <= x2) and (mouseY >= y1 and mouseY <= y2)
            end

            closeDropdown = function(animate)
                dropdownToken = dropdownToken + 1
                local token = dropdownToken
                activeCleanups[cleanupOpenDropdown] = nil
                if outsideConn then
                    disconnectConn(outsideConn)
                    outsideConn = nil
                end

                local closingContainer = activeContainer
                activeContainer = nil
                selectionLbl.TextColor3 = library.options.textcolor
                selectionLbl.Text = location[flag] ~= nil and tostring(location[flag]) or ""

                if not closingContainer then
                    return
                end

                if animate then
                    tweenObject(closingContainer, 0.15, Enum.EasingStyle.Quint, Enum.EasingDirection.In, {
                        Size = UDim2.new(1, 0, 0, 0),
                    }, function()
                        if token == dropdownToken or closingContainer.Parent ~= nil then
                            pcall(closingContainer.Destroy, closingContainer)
                        end
                    end)
                else
                    pcall(closingContainer.Destroy, closingContainer)
                end
            end

            connectSignal(dropBtn.MouseButton1Click, function()
                if outsideConn then
                    closeDropdown(true)
                    return
                end

                dropdownToken = dropdownToken + 1
                selectionLbl.TextColor3 = Color3.fromRGB(60, 60, 60)
                selectionLbl.Text = name

                local totalHeight = #list * 20
                local scrollSize = totalHeight > 100 and 5 or 0
                local clampedHeight = math.min(totalHeight, 100)
                local goSize = UDim2.new(1, 0, 0, clampedHeight)

                local container = library:Create("ScrollingFrame", {
                    TopImage = "rbxasset://textures/ui/Scroll/scroll-middle.png",
                    BottomImage = "rbxasset://textures/ui/Scroll/scroll-middle.png",
                    Name = "DropContainer",
                    Parent = dropdownLbl,
                    Size = UDim2.new(1, 0, 0, 0),
                    BackgroundColor3 = library.options.bgcolor,
                    BorderColor3 = library.options.bordercolor,
                    Position = UDim2.new(0, 0, 1, 0),
                    ScrollBarThickness = scrollSize,
                    CanvasSize = UDim2.new(0, 0, 0, totalHeight),
                    ZIndex = 5,
                    ClipsDescendants = true,
                    library:Create("UIListLayout", {
                        Name = "List",
                        SortOrder = Enum.SortOrder.LayoutOrder,
                    }),
                })
                activeContainer = container

                for i, v in next, list do
                    local valText = tostring(v)
                    local btn = library:Create("TextButton", {
                        Size = UDim2.new(1, 0, 0, 20),
                        BackgroundColor3 = library.options.btncolor,
                        BorderColor3 = library.options.bordercolor,
                        Text = valText,
                        Font = library.options.font,
                        TextSize = library.options.fontsize,
                        LayoutOrder = i,
                        Parent = container,
                        ZIndex = 5,
                        TextColor3 = library.options.textcolor,
                        TextStrokeTransparency = library.options.textstroke,
                        TextStrokeColor3 = library.options.strokecolor,
                    })

                    connectSignal(btn.MouseButton1Click, function()
                        location[flag] = valText
                        callback(valText)
                        closeDropdown(false)
                    end, true)
                end

                tweenObject(container, 0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.Out, { Size = goSize })

                if UserInputService then
                    activeCleanups[cleanupOpenDropdown] = true
                    outsideConn = connectSignal(UserInputService.InputBegan, function(a)
                        if destroyed or not isObjectAlive(activeContainer) then
                            closeDropdown(false)
                            return
                        end
                        if a and a.UserInputType == Enum.UserInputType.MouseButton1 and not isInGui(activeContainer) then
                            closeDropdown(true)
                        end
                    end, true)
                end
            end)

            self:Resize()
            local dropdownApi = {}
            local function reload(selfOrArray, array)
                local nextList = (selfOrArray == dropdownApi) and array or (array ~= nil and array or selfOrArray)
                list = type(nextList) == "table" and nextList or {}
                location[flag] = list[1]
                closeDropdown(false)
            end
            dropdownApi.Refresh = reload
            return dropdownApi
        end
    end

    function library:Create(class, data)
        local obj = Instance.new(class)
        if not data then
            return obj
        end
        for i, v in next, data do
            if i ~= "Parent" then
                if valueType(v) == "Instance" then
                    v.Parent = obj
                else
                    obj[i] = v
                end
            end
        end

        obj.Parent = data.Parent
        return obj
    end

