if not game:IsLoaded() then
    game.Loaded:Wait()
end

local env = (type(getgenv) == "function" and getgenv()) or _G
local runId = (tonumber(env.AntiAFKRunId) or 0) + 1
env.AntiAFKRunId = runId

local function disconnectConn(conn)
    if not conn then
        return
    end
    pcall(function()
        conn:Disconnect()
    end)
end

-- Clean up any previous Anti-AFK run (including legacy globals)
if type(env.__AntiAFKState) == "table" and type(env.__AntiAFKState.cleanup) == "function" then
    pcall(env.__AntiAFKState.cleanup)
end
if env.AntiAFKConnection then
    disconnectConn(env.AntiAFKConnection)
    env.AntiAFKConnection = nil
end

local DEFAULT_SETTINGS = {
    Interval = 540, -- Fallback trigger interval in seconds (below 10/15/20 min AFK kicks)
    Cooldown = 10, -- Minimum seconds between simulated activity pulses
    DisableNativeIdled = true, -- Disable pre-existing Idled listeners once at startup
    UseVirtualUser = true, -- Simulate non-intrusive VirtualUser ClickButton2 activity
    UseVirtualInputManager = false, -- Opt-in only: disabled by default due to executor C++ instability on SendKeyEvent
    MicroJump = false, -- Optional jump pulse for games with server-side movement checks
    Notify = false, -- Optional StarterGui notification on load
}

local function mergeSettings(defaults, overrides)
    overrides = type(overrides) == "table" and overrides or {}
    local result = {}
    for key, default in pairs(defaults) do
        local override = overrides[key]
        if override ~= nil then
            result[key] = override
        else
            result[key] = default
        end
    end
    return result
end

local userSettings = (type(_G.AntiAFKSettings) == "table" and _G.AntiAFKSettings)
    or (env ~= _G and type(env.AntiAFKSettings) == "table" and env.AntiAFKSettings)
    or nil

local cfg = mergeSettings(DEFAULT_SETTINGS, userSettings)
cfg.Interval = math.max(15, tonumber(cfg.Interval) or DEFAULT_SETTINGS.Interval)
cfg.Cooldown = math.max(1, tonumber(cfg.Cooldown) or DEFAULT_SETTINGS.Cooldown)

_G.AntiAFKSettings = cfg
if env ~= _G and type(env.AntiAFKSettings) == "table" then
    env.AntiAFKSettings = cfg
end

local function safeGetService(name)
    if not game or type(game.GetService) ~= "function" then
        return nil
    end
    local ok, service = pcall(game.GetService, game, name)
    if ok then
        return service
    end
    return nil
end

local Players = safeGetService("Players")
if not Players then
    error("[Anti-AFK] Players service unavailable")
end

local waitTask = (type(task) == "table" and task.wait) or wait
local spawnTask = (type(task) == "table" and task.spawn) or function(fn)
    local co = coroutine.create(fn)
    local ok, err = coroutine.resume(co)
    if not ok then
        warn("[Anti-AFK] Task error:", err)
    end
    return co
end
local cancelTask = type(task) == "table" and type(task.cancel) == "function" and task.cancel or nil

local LocalPlayer = Players.LocalPlayer
if not LocalPlayer then
    repeat
        waitTask()
        LocalPlayer = Players.LocalPlayer
    until LocalPlayer
end

local VirtualUser = cfg.UseVirtualUser and safeGetService("VirtualUser") or nil
local VirtualInputManager = cfg.UseVirtualInputManager and safeGetService("VirtualInputManager") or nil
local UserInputService = safeGetService("UserInputService")
local StarterGui = cfg.Notify and safeGetService("StarterGui") or nil

local getConns = (type(getconnections) == "function" and getconnections)
    or (type(get_signal_cons) == "function" and get_signal_cons)
    or nil

local F15_KEY = nil
if cfg.UseVirtualInputManager then
    local okKey, val = pcall(function()
        return Enum.KeyCode.F15
    end)
    if okKey then
        F15_KEY = val
    end
end

local connections = {}
local isCleanedUp = false
local isSimulating = false
local lastActivity = os.clock()
local lastSimulatedAt = -math.huge
local loopThread = nil

local state = {
    runId = runId,
}

local function isActive()
    return (not isCleanedUp) and env.__AntiAFKState == state and env.AntiAFKRunId == runId
end

local function trackConnection(signal, callback)
    if not signal then
        return nil
    end
    local ok, conn = pcall(function()
        return signal:Connect(callback)
    end)
    if ok and conn then
        connections[#connections + 1] = conn
        return conn
    end
    return nil
end

state.cleanup = function()
    if isCleanedUp then
        return
    end
    isCleanedUp = true
    for i = #connections, 1, -1 do
        disconnectConn(connections[i])
        connections[i] = nil
    end
    if loopThread and cancelTask then
        pcall(cancelTask, loopThread)
    end
    loopThread = nil
    env.AntiAFKConnection = nil
end

env.__AntiAFKState = state

local function disableExistingIdledConnections(handlerFn)
    if not (cfg.DisableNativeIdled and getConns and LocalPlayer.Idled) then
        return
    end
    pcall(function()
        local list = getConns(LocalPlayer.Idled)
        if type(list) ~= "table" then
            return
        end
        for _, conn in ipairs(list) do
            if conn and conn.Function ~= handlerFn then
                if conn.Disable then
                    pcall(conn.Disable, conn)
                elseif conn.Disconnect then
                    pcall(conn.Disconnect, conn)
                end
            end
        end
    end)
end

local function simulateActivity()
    if not isActive() or isSimulating then
        return false
    end

    local now = os.clock()
    if (now - lastSimulatedAt) < cfg.Cooldown then
        return false
    end

    isSimulating = true
    lastSimulatedAt = now
    lastActivity = now

    local ok, err = pcall(function()
        if cfg.UseVirtualUser and VirtualUser then
            -- Synchronous ClickButton2 avoids yielding inside the Idled signal callback
            local zeroVec = Vector2 and Vector2.new(0, 0)
            pcall(function()
                VirtualUser:CaptureController()
                VirtualUser:ClickButton2(zeroVec)
            end)
        end

        if cfg.UseVirtualInputManager and VirtualInputManager and F15_KEY then
            pcall(function()
                VirtualInputManager:SendKeyEvent(true, F15_KEY, false, game)
                waitTask(0.02)
                VirtualInputManager:SendKeyEvent(false, F15_KEY, false, game)
            end)
        end

        if cfg.MicroJump then
            pcall(function()
                local char = LocalPlayer.Character
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 then
                    hum.Jump = true
                end
            end)
        end
    end)

    isSimulating = false
    lastActivity = os.clock()

    if not ok then
        warn("[Anti-AFK] Simulation error:", err)
    end
    return ok
end

local function idledHandler()
    if not isActive() then
        return
    end
    simulateActivity()
end

-- 1. Disable built-in / pre-existing Idled listeners once at startup (never inside Idled dispatch)
disableExistingIdledConnections(idledHandler)
env.AntiAFKConnection = trackConnection(LocalPlayer.Idled, idledHandler)

-- 2. Track real player input so periodic pulses never interrupt active gameplay
if UserInputService then
    local function markUserActive()
        if isActive() and not isSimulating then
            lastActivity = os.clock()
        end
    end
    trackConnection(UserInputService.InputBegan, markUserActive)
    trackConnection(UserInputService.InputChanged, markUserActive)
end

-- 3. Periodic idle fallback loop (handles games/executors where Idled is bypassed or custom)
local checkStep = math.min(60, cfg.Interval)
loopThread = spawnTask(function()
    while isActive() and LocalPlayer.Parent do
        waitTask(checkStep)
        if not isActive() or not LocalPlayer.Parent then
            break
        end
        if (os.clock() - lastActivity) >= cfg.Interval then
            simulateActivity()
        end
    end
end)

if cfg.Notify and StarterGui then
    pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title = "Anti-AFK",
            Text = "Universal Anti-AFK enabled.",
            Duration = 4,
        })
    end)
end

print("[Anti-AFK] Universal Anti-AFK successfully loaded!")
