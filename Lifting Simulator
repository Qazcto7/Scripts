local NON_WEIGHT_PATTERNS = { "punch", "fist", "kick", "stomp", "slash", "blood", "wolf", "spartan", "rage", "skill" }

local function pickWeightTool(backpack)
    if not backpack then
        return nil
    end
    local fallback = nil
    for _, item in ipairs(backpack:GetChildren()) do
        if item:IsA("Tool") then
            fallback = fallback or item
            local lowerName = string.lower(tostring(item.Name or ""))
            local isSkill = false
            for _, pat in ipairs(NON_WEIGHT_PATTERNS) do
                if string.find(lowerName, pat, 1, true) then
                    isSkill = true
                    break
                end
            end
            if not isSkill then
                return item
            end
        end
    end
    return fallback
end

-- Equip Weight tool & activate ONLY while Auto Lift, Auto Lift x100, or Tool Farm is enabled
local function equipAndFarm()
    local player = Players.LocalPlayer
    while isActive() do
        local farmingActive = (w.flags.AutoLift == true or w.flags.AutoLift1 == true or w.flags.ToolFarm == true)
            and not isFarmPaused()
        if not farmingActive then
            safeWait(0.15)
        else
            pcall(function()
                player = player or Players.LocalPlayer
                if player and player.Character then
                    local toolEquipped = player.Character:FindFirstChildOfClass("Tool")
                    if not toolEquipped then
                        local backpack = player:FindFirstChildOfClass("Backpack") or player.Backpack
                        local weightTool = pickWeightTool(backpack)
                        if weightTool then
                            weightTool.Parent = player.Character
                        end
                    end

                    local activeTool = player.Character:FindFirstChildOfClass("Tool")
                    if activeTool then
                        activeTool:Activate()
                    end
                end
            end)
            safeWait(0.08)
        end
    end
end

safeSpawn(equipAndFarm)

