-- Function to automatically equip the first tool in the backpack and activate it for farming
local function equipAndFarm()
    local player = Players.LocalPlayer
    while true do
        safeWait()
        pcall(function()
            player = player or Players.LocalPlayer
            if player and player.Character then
                local toolEquipped = player.Character:FindFirstChildOfClass("Tool")
                if not toolEquipped then
                    local backpack = player:FindFirstChildOfClass("Backpack") or player.Backpack
                    if backpack then
                        for _, item in ipairs(backpack:GetChildren()) do
                            if item:IsA("Tool") then
                                item.Parent = player.Character
                                break
                            end
                        end
                    end
                end

                local activeTool = player.Character:FindFirstChildOfClass("Tool")
                if activeTool then
                    activeTool:Activate()
                end
            end
        end)
    end
end

safeSpawn(equipAndFarm)

