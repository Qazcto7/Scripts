local function safeWait(sec)
    if type(task) == "table" and type(task.wait) == "function" then
        if sec ~= nil then
            task.wait(sec)
        else
            task.wait()
        end
        return
    end
    if type(wait) == "function" then
        if sec ~= nil then
            wait(sec)
        else
            wait()
        end
    end
end

local function safeSpawn(fn)
    if type(task) == "table" and type(task.spawn) == "function" then
        return task.spawn(fn)
    end
    if type(spawn) == "function" then
        return spawn(fn)
    end
    local co = coroutine.create(fn)
    coroutine.resume(co)
    return co
end

local function safeDefer(fn)
    if type(task) == "table" and type(task.defer) == "function" then
        return task.defer(fn)
    end
    return safeSpawn(function()
        safeWait()
        fn()
    end)
end

-- Initialize settings table with default values
local settingsTable = {
    AutoLift = false,
    AutoLift1 = false,
    AutoSell = false,
    ToolFarm = false,
}

-- Function to load settings from the file
local function loadSettings()
    if isfile and isfile(filename) then
        local okRead, fileContent = pcall(readfile, filename)
        if okRead and type(fileContent) == "string" and fileContent ~= "" then
            local okDecode, decoded = pcall(function()
                return HttpService:JSONDecode(fileContent)
            end)
            if okDecode and type(decoded) == "table" then
                for k, v in pairs(decoded) do
                    settingsTable[k] = v
                end
                print("Settings loaded")
            end
        end
    end
end

-- Function to save settings to the file
local function saveSettings()
    if not writefile then
        return
    end
    pcall(function()
        local json = HttpService:JSONEncode(settingsTable)
        writefile(filename, json)
    end)
end

-- Load settings when the script starts
loadSettings()

