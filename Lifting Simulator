local remoteEvent = nil
local function getRemoteEvent()
    if remoteEvent then
        local okParent, hasParent = pcall(function()
            return remoteEvent.Parent ~= nil
        end)
        if okParent and hasParent then
            return remoteEvent
        end
        remoteEvent = nil
    end
    local okFind, found = pcall(function()
        return ReplicatedStorage:FindFirstChild("RemoteEvent") or ReplicatedStorage:WaitForChild("RemoteEvent", 2)
    end)
    if okFind and found then
        remoteEvent = found
        return remoteEvent
    end
    local okDirect, direct = pcall(function()
        return ReplicatedStorage.RemoteEvent
    end)
    if okDirect and direct then
        remoteEvent = direct
        return remoteEvent
    end
    return nil
end

