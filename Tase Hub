-- Reusable RaycastParams (zero per-frame allocations)
local rayParams = RaycastParams and RaycastParams.new() or nil
local lastFilteredChar = nil
if rayParams then
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    rayParams.IgnoreWater = true
end

local function isLineOfSightClear(camPos, targetPos, targetChar)
    if not rayParams then
        return true
    end
    local myChar = LocalPlayer and LocalPlayer.Character
    if myChar ~= lastFilteredChar then
        lastFilteredChar = myChar
        rayParams.FilterDescendantsInstances = myChar and { myChar } or {}
    end
    local ray = Workspace:Raycast(camPos, targetPos - camPos, rayParams)
    if ray and ray.Instance then
        return ray.Instance:IsDescendantOf(targetChar)
    end
    return true
end

local function isRightMouseHeld()
    if not cfg.RequireRightClick then
        return true
    end
    local ok, down = pcall(UIS.IsMouseButtonPressed, UIS, Enum.UserInputType.MouseButton2)
    return ok and down == true
end

track(UIS.JumpRequest, function()
    if not isActive() or not cfg.InfJump then
        return
    end
    local char = LocalPlayer and LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum then
        hum:ChangeState(Enum.HumanoidStateType.Jumping)
    end
end)

-- Run NoClip on Stepped so Humanoid collision overrides never push back
local noclipSignal = RunService.Stepped or RunService.RenderStepped
track(noclipSignal, function()
    if not isActive() or not cfg.NoClip then
        return
    end
    local myChar = LocalPlayer and LocalPlayer.Character
    if not myChar then
        return
    end
    for _, part in ipairs(myChar:GetDescendants()) do
        if part:IsA("BasePart") and part.CanCollide then
            if state.noclipParts[part] == nil then
                state.noclipParts[part] = true
            end
            part.CanCollide = false
        end
    end
end)

local tagScaleAccum = 0

-- Single consolidated RenderStepped loop (Movement WalkSpeed, FOV Circle, NameTag Scaling, Aimbot)
track(RunService.RenderStepped, function(dt)
    if not isActive() then
        return
    end

    if cfg.SpeedValue ~= 16 then
        local myChar = LocalPlayer and LocalPlayer.Character
        local hum = myChar and myChar:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.WalkSpeed = cfg.SpeedValue
            state.lastWalkSpeedApplied = true
        end
    end

    local cam = Workspace.CurrentCamera
    if not cam then
        return
    end

    local vp = cam.ViewportSize
    local screenCenter = Vector2.new(vp.X * 0.5, vp.Y * 0.5)

    if Circle then
        Circle.Position = screenCenter
        Circle.Radius = cfg.AimFOV
        if cfg.RainbowFOV and cfg.Aimbot then
            Circle.Color = Color3.fromHSV((os.clock() % 5) / 5, 1, 1)
        end
    end

    -- Throttled NameTag distance scaling (~20 Hz instead of uncapped per-frame work)
    tagScaleAccum = tagScaleAccum + (tonumber(dt) or 0.016)
    if cfg.NameTags and tagScaleAccum >= 0.05 then
        tagScaleAccum = 0
        local camPos = cam.CFrame.Position
        for player, data in pairs(state.activeTags) do
            if data.gui and data.gui.Parent and data.head and data.head.Parent then
                local dist = (camPos - data.head.Position).Magnitude
                local alpha = math.clamp((dist - 15) / 145, 0, 1)
                data.scale.Scale = 0.85 + ((1 - alpha) * 0.3)
            else
                clearTag(player)
            end
        end
    end

    if not cfg.Aimbot or not isRightMouseHeld() then
        return
    end

    local camPos = cam.CFrame.Position
    local bestTarget = nil
    local shortestDist = cfg.AimFOV
    local myTeam = LocalPlayer and LocalPlayer.Team

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local char = player.Character
            if char then
                local teamAllowed = not (cfg.TeamCheck and myTeam ~= nil and player.Team == myTeam)
                local targetPart = teamAllowed and (char:FindFirstChild(cfg.TargetPart) or char:FindFirstChild("Head"))
                local hum = targetPart and char:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 then
                    local screenPos, visible = cam:WorldToViewportPoint(targetPart.Position)
                    if visible and screenPos.Z > 0 then
                        local dist = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
                        if dist < shortestDist then
                            if (not cfg.WallCheck) or isLineOfSightClear(camPos, targetPart.Position, char) then
                                shortestDist = dist
                                bestTarget = targetPart
                            end
                        end
                    end
                end
            end
        end
    end

    if bestTarget then
        local aimPos = bestTarget.Position
        if cfg.Prediction then
            local vel = bestTarget.AssemblyLinearVelocity
            local travelTime = (camPos - aimPos).Magnitude / math.max(cfg.BulletSpeed, 1)
            aimPos = aimPos + (vel * travelTime)
        end
        local goalCFrame = CFrame.new(camPos, aimPos)
        if cfg.Smoothness <= 1 then
            cam.CFrame = goalCFrame
        else
            local frameAlpha = math.clamp(((tonumber(dt) or 0.016) * 60) / cfg.Smoothness, 0.02, 1)
            cam.CFrame = cam.CFrame:Lerp(goalCFrame, frameAlpha)
        end
    end
end)
