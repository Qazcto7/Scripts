VisualTab:CreateButton({
    Name = "FPS Boost",
    Callback = function()
        task.spawn(function()
            local smooth = Enum.Material.SmoothPlastic
            local okList, descendants = pcall(Workspace.GetDescendants, Workspace)
            if not okList or type(descendants) ~= "table" then
                return
            end
            local playerChars = {}
            for _, p in ipairs(Players:GetPlayers()) do
                if p.Character then
                    playerChars[p.Character] = true
                end
            end
            local function isCharacterPart(inst)
                local node = inst
                while node and node ~= Workspace do
                    if playerChars[node] then
                        return true
                    end
                    node = node.Parent
                end
                return false
            end
            for i = 1, #descendants do
                if not isActive() then
                    return
                end
                local inst = descendants[i]
                if inst then
                    pcall(function()
                        if inst:IsA("BasePart") and not inst:IsA("Terrain") and not isCharacterPart(inst) then
                            inst.Material = smooth
                            inst.Reflectance = 0
                            inst.CastShadow = false
                        end
                    end)
                end
                if i % 256 == 0 then
                    task.wait()
                end
            end
        end)
    end,
})

state.cleanup = function()
    if state.unloaded then
        return
    end
    state.unloaded = true
    restoreNoClip()
    if state.lastWalkSpeedApplied then
        local char = LocalPlayer and LocalPlayer.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if hum then
            pcall(function()
                hum.WalkSpeed = 16
            end)
        end
    end
    for p in pairs(state.playerConns) do
        clearPlayerVisuals(p)
        disconnectPlayerSignals(p)
    end
    for p in pairs(state.activeHighlights) do
        clearHighlight(p)
    end
    for p in pairs(state.activeTags) do
        clearTag(p)
    end
    for i = #state.connections, 1, -1 do
        disconnectConn(state.connections[i])
        state.connections[i] = nil
    end
    if Circle then
        pcall(function()
            Circle.Visible = false
            if type(Circle.Remove) == "function" then
                Circle:Remove()
            elseif type(Circle.Destroy) == "function" then
                Circle:Destroy()
            end
        end)
        Circle = nil
    end
    if Rayfield and type(Rayfield.Destroy) == "function" then
        pcall(function()
            Rayfield:Destroy()
        end)
    end
end
env.__TaseHubState = state

