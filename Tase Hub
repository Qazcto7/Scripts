    Police = Color3.fromRGB(0, 120, 255),
    Prisoner = Color3.fromRGB(255, 170, 0),
    Criminal = Color3.fromRGB(255, 0, 0),
}

local cfg = {
    Aimbot = false,
    RequireRightClick = false,
    AimFOV = 150,
    Smoothness = 1,
    TargetPart = "Head",
