local state = {
    unloaded = false,
    connections = {},
    playerConns = {},
    activeTags = {},
    activeHighlights = {},
    avatarCache = {},
    noclipParts = {},
    lastWalkSpeedApplied = false,
}

local function isActive()
    return (not state.unloaded) and env.__TaseHubState == state
end

local function track(signal, fn)
    if not signal then
        return nil
    end
    local ok, conn = pcall(function()
        return signal:Connect(fn)
    end)
    if ok and conn then
        state.connections[#state.connections + 1] = conn
        return conn
    end
    return nil
end

local function disconnectConn(conn)
    if conn then
        pcall(function()
            conn:Disconnect()
        end)
    end
end

local function destroySafe(obj)
    if obj then
        pcall(function()
            obj:Destroy()
        end)
    end
end

local function getTeamColor(player)
    local team = player and player.Team
    if team then
        if TEAM_COLORS[team.Name] then
            return TEAM_COLORS[team.Name]
        end
        local okColor, tColor = pcall(function()
            return team.TeamColor and team.TeamColor.Color
        end)
        if okColor and tColor then
            return tColor
        end
    end
    return Color3.fromRGB(255, 255, 255)
end

local Circle = nil
pcall(function()
    if type(Drawing) == "table" and type(Drawing.new) == "function" then
        Circle = Drawing.new("Circle")
        Circle.Visible = false
        Circle.Thickness = 2
        Circle.Radius = cfg.AimFOV
        Circle.Color = Color3.fromRGB(255, 255, 255)
        Circle.Filled = false
    end
end)

local function clearHighlight(player)
    local h = state.activeHighlights[player]
    state.activeHighlights[player] = nil
    destroySafe(h)
end

local function clearTag(player)
    local data = state.activeTags[player]
    state.activeTags[player] = nil
    if not data then
        return
    end
    disconnectConn(data.healthConn)
    disconnectConn(data.maxHealthConn)
    destroySafe(data.gui)
end

local function clearPlayerVisuals(player)
    clearHighlight(player)
    clearTag(player)
end

local function disconnectPlayerSignals(player)
    local list = state.playerConns[player]
    state.playerConns[player] = nil
    if list then
        for i = 1, #list do
            disconnectConn(list[i])
        end
    end
end

local function restoreNoClip()
    for part, origCollide in pairs(state.noclipParts) do
        state.noclipParts[part] = nil
        if part then
            pcall(function()
                if part.Parent then
                    part.CanCollide = origCollide
                end
            end)
        end
    end
end

local function syncPlayerHighlight(player)
    if not isActive() or player == LocalPlayer then
        return
    end
    local char = player.Character
    if not cfg.ESP or not char then
        clearHighlight(player)
        return
    end

    local color = getTeamColor(player)
    local existing = state.activeHighlights[player]
    if existing then
        local okAlive, alive = pcall(function()
            return existing.Parent == char
        end)
        if okAlive and alive then
            pcall(function()
                existing.FillColor = color
                existing.OutlineColor = color
            end)
            return
        end
    end

    clearHighlight(player)
    pcall(function()
        local stale = char:FindFirstChild("TaseHubESP") or char:FindFirstChild("ZenithESP")
        if stale then
            stale:Destroy()
        end
        local highlight = Instance.new("Highlight")
        highlight.Name = "TaseHubESP"
        highlight.FillColor = color
        highlight.OutlineColor = color
        highlight.FillTransparency = 0.55
        highlight.OutlineTransparency = 0
        highlight.Parent = char
        state.activeHighlights[player] = highlight
    end)
end

local function createNameTag(player, character)
    if not isActive() or not cfg.NameTags or not character then
        return
    end
    local head = character:FindFirstChild("Head")
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not head or not humanoid then
        return
    end

    local existing = state.activeTags[player]
    if existing then
        local okAlive, alive = pcall(function()
            return existing.gui and existing.gui.Parent == head and existing.head == head
        end)
        if okAlive and alive then
            pcall(function()
                existing.stroke.Color = getTeamColor(player)
            end)
            return
        end
        clearTag(player)
    end

    pcall(function()
        local old = head:FindFirstChild("CustomNameTag")
        if old then
            old:Destroy()
        end

        local gui = Instance.new("BillboardGui")
        gui.Name = "CustomNameTag"
        gui.Adornee = head
        gui.Size = UDim2.fromOffset(112, 32)
        gui.StudsOffset = Vector3.new(0, 2.7, 0)
        gui.AlwaysOnTop = true
        gui.MaxDistance = 0

        local frame = Instance.new("Frame")
        frame.Size = UDim2.fromScale(1, 1)
        frame.BackgroundColor3 = Color3.fromRGB(15, 17, 22)
        frame.BackgroundTransparency = 0.1
        frame.BorderSizePixel = 0
        frame.Parent = gui

        local uiScale = Instance.new("UIScale")
        uiScale.Scale = 1
        uiScale.Parent = frame

        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 6)
        corner.Parent = frame

        local stroke = Instance.new("UIStroke")
        stroke.Thickness = 1
        stroke.Color = getTeamColor(player)
        stroke.Parent = frame

        local avatar = Instance.new("ImageLabel")
        avatar.Size = UDim2.fromOffset(27, 27)
        avatar.Position = UDim2.fromOffset(3, 2)
        avatar.BackgroundTransparency = 1
        avatar.Parent = frame

        local avatarCorner = Instance.new("UICorner")
        avatarCorner.CornerRadius = UDim.new(0, 5)
        avatarCorner.Parent = avatar

        local cachedThumb = state.avatarCache[player.UserId]
        if cachedThumb then
            avatar.Image = cachedThumb
        else
            task.spawn(function()
                local okThumb, image = pcall(function()
                    return Players:GetUserThumbnailAsync(
                        player.UserId,
                        Enum.ThumbnailType.HeadShot,
                        Enum.ThumbnailSize.Size100x100
                    )
                end)
                if okThumb and type(image) == "string" and image ~= "" then
                    state.avatarCache[player.UserId] = image
                    if isActive() and avatar.Parent then
                        avatar.Image = image
                    end
                end
            end)
        end

        local nameLbl = Instance.new("TextLabel")
        nameLbl.Position = UDim2.fromOffset(35, 2)
        nameLbl.Size = UDim2.new(1, -40, 0, 15)
        nameLbl.BackgroundTransparency = 1
        nameLbl.Text = player.Name
        nameLbl.TextColor3 = Color3.new(1, 1, 1)
        nameLbl.TextSize = 10
        nameLbl.Font = Enum.Font.GothamBold
        nameLbl.TextXAlignment = Enum.TextXAlignment.Left
        nameLbl.TextTruncate = Enum.TextTruncate.AtEnd
        nameLbl.Parent = frame

        local hpBackground = Instance.new("Frame")
        hpBackground.Position = UDim2.fromOffset(35, 21)
        hpBackground.Size = UDim2.new(1, -40, 0, 6)
        hpBackground.BackgroundColor3 = Color3.fromRGB(55, 55, 55)
        hpBackground.BorderSizePixel = 0
        hpBackground.ClipsDescendants = true
        hpBackground.Parent = frame

        local hpCorner = Instance.new("UICorner")
        hpCorner.CornerRadius = UDim.new(1, 0)
        hpCorner.Parent = hpBackground

        local hpFill = Instance.new("Frame")
        hpFill.Size = UDim2.fromScale(1, 1)
        hpFill.BackgroundColor3 = Color3.fromRGB(50, 220, 100)
        hpFill.BorderSizePixel = 0
        hpFill.Parent = hpBackground

        local fillCorner = Instance.new("UICorner")
        fillCorner.CornerRadius = UDim.new(1, 0)
        fillCorner.Parent = hpFill

        local function updateHealth()
            if not isActive() then
                return
            end
            local percent = math.clamp(humanoid.Health / math.max(humanoid.MaxHealth, 1), 0, 1)
            hpFill.Size = UDim2.fromScale(percent, 1)
            stroke.Color = getTeamColor(player)
            if percent <= 0.25 then
                hpFill.BackgroundColor3 = Color3.fromRGB(240, 65, 65)
            elseif percent <= 0.5 then
                hpFill.BackgroundColor3 = Color3.fromRGB(240, 190, 60)
            else
                hpFill.BackgroundColor3 = Color3.fromRGB(50, 220, 100)
            end
        end

        local hConn = humanoid.HealthChanged:Connect(updateHealth)
        local mhConn = nil
        if type(humanoid.GetPropertyChangedSignal) == "function" then
            local okMh, mhSig = pcall(humanoid.GetPropertyChangedSignal, humanoid, "MaxHealth")
            if okMh and mhSig then
                mhConn = mhSig:Connect(updateHealth)
            end
        end
        updateHealth()

        gui.Parent = head
        state.activeTags[player] = {
            gui = gui,
            head = head,
            scale = uiScale,
            stroke = stroke,
            healthConn = hConn,
            maxHealthConn = mhConn,
        }
    end)
end

local function syncPlayerVisuals(player)
    if not isActive() or player == LocalPlayer then
        return
    end
    syncPlayerHighlight(player)
    if cfg.NameTags and player.Character then
        createNameTag(player, player.Character)
    else
        clearTag(player)
    end
end

local function syncAllVisuals()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            syncPlayerVisuals(p)
        end
    end
end

local function hookPlayer(player)
    if player == LocalPlayer then
        return
    end
    disconnectPlayerSignals(player)
    local list = {}
    state.playerConns[player] = list

    local function bindCharacter(char)
        if not isActive() or not char then
            return
        end
        syncPlayerVisuals(player)
        if not (char:FindFirstChild("Head") and char:FindFirstChildOfClass("Humanoid")) then
            local childConn
            childConn = char.ChildAdded:Connect(function()
                if not isActive() or not char.Parent then
                    disconnectConn(childConn)
                    return
                end
                if char:FindFirstChild("Head") and char:FindFirstChildOfClass("Humanoid") then
                    disconnectConn(childConn)
                    syncPlayerVisuals(player)
                end
            end)
            list[#list + 1] = childConn
        end
    end

    if player.Character then
        bindCharacter(player.Character)
    end
    list[#list + 1] = player.CharacterAdded:Connect(bindCharacter)
    list[#list + 1] = player.CharacterRemoving:Connect(function()
        clearPlayerVisuals(player)
    end)
    if type(player.GetPropertyChangedSignal) == "function" then
        local okSig, sig = pcall(player.GetPropertyChangedSignal, player, "Team")
        if okSig and sig then
            list[#list + 1] = sig:Connect(function()
                syncPlayerVisuals(player)
            end)
        end
    end
end

for _, p in ipairs(Players:GetPlayers()) do
    hookPlayer(p)
end
track(Players.PlayerAdded, hookPlayer)
track(Players.PlayerRemoving, function(player)
    clearPlayerVisuals(player)
    disconnectPlayerSignals(player)
    state.avatarCache[player.UserId] = nil
end)
if LocalPlayer and LocalPlayer.CharacterRemoving then
    track(LocalPlayer.CharacterRemoving, function()
        state.noclipParts = {}
    end)
end

